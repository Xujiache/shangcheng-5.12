@import "../../styles/tokens.wxss";
.history-page { min-height: 100vh; color: var(--text); }.history-page__body { padding: 16px 16px calc(34px + env(safe-area-inset-bottom)); }.history-page__top { display:flex; justify-content:space-between; align-items:center; margin: 5px 2px 12px; color:var(--muted); font-size:13px; font-weight:800; }.history-page__clear { color:var(--accent-text); font-size:12px; }.history-item { min-height:70px; position:relative; display:flex; align-items:center; margin-bottom:10px; padding:13px 42px 13px 15px; box-sizing:border-box; background:var(--surface); border:1px solid var(--border); border-radius:16px; box-shadow:var(--shadow-soft); }.history-item__copy { min-width:0; flex:1; }.history-item__title { overflow:hidden; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; color:var(--text); font-size:13px; font-weight:700; line-height:1.5; }.history-item__meta { display:flex; gap:10px; margin-top:6px; color:var(--muted); font-size:10px; }.history-item__delete { position:absolute; right:7px; top:20px; width:30px; height:30px; margin:0; padding:0; color:var(--faint); font-size:22px; line-height:30px; background:transparent; }.history-empty { margin-top:82px; padding:34px 16px; text-align:center; color:var(--text); font-size:15px; font-weight:800; background:var(--surface); border:1px solid var(--border); border-radius:18px; }.history-empty__icon { margin-bottom:12px; color:var(--accent-text); font-size:34px; }.history-empty text { display:block; margin-top:7px; color:var(--muted); font-size:11px; font-weight:400; }
