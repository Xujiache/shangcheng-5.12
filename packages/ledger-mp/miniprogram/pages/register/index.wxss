.reg__hero {
  text-align: center;
  padding: 6px 0 22px;
}
.reg__name {
  font-size: 22px;
  font-weight: 800;
  color: var(--text);
}
.reg__sub {
  font-size: 13px;
  color: var(--muted);
  margin-top: 6px;
}
.reg__form {
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.reg__closed {
  text-align: left;
  font-size: 13px;
  line-height: 1.7;
  color: var(--muted);
  padding: 14px 16px;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.76);
  border: 1px solid rgba(31, 107, 92, 0.1);
}
.reg__foot {
  text-align: center;
  margin-top: 16px;
  font-size: 13.5px;
  color: var(--muted);
}
.reg__link {
  color: var(--accent);
  margin-left: 2px;
}
