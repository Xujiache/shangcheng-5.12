@import "../../styles/tokens.wxss";
.platforms-page { min-height:100vh; color:var(--text); }.platforms-page__body { padding:16px 16px calc(34px + env(safe-area-inset-bottom)); }.platforms-intro { padding:14px 3px 18px; }.platforms-intro__title { color:var(--text); font-size:22px; font-weight:800; }.platforms-intro__sub { margin-top:7px; color:var(--muted); font-size:12px; }.platform-card { display:flex; align-items:center; gap:12px; min-height:70px; margin-bottom:10px; padding:10px 14px; box-sizing:border-box; background:var(--surface); border:1px solid var(--border); border-radius:16px; box-shadow:var(--shadow-soft); }.platform-card__mark { width:42px; height:42px; display:flex; align-items:center; justify-content:center; border-radius:13px; color:#fff; font-size:18px; font-weight:800; }.platform-card__mark--douyin { background:#242424; }.platform-card__mark--kuaishou { background:#f09a28; }.platform-card__mark--bilibili { background:#f08bab; }.platform-card__mark--tiktok { background:#1d9f9b; }.platform-card__title { color:var(--text); font-size:14px; font-weight:800; }.platform-card__desc { margin-top:4px; color:var(--muted); font-size:11px; }.platform-card__status { margin-left:auto; color:var(--accent-text); font-size:18px; font-weight:800; }.more-platforms { display:flex; align-items:center; justify-content:space-between; margin-top:18px; padding:15px; background:var(--surface); border:1px solid var(--border); border-radius:16px; }.more-platforms__title { color:var(--text); font-size:14px; font-weight:800; }.more-platforms__desc { margin-top:5px; color:var(--muted); font-size:11px; }.more-platforms > text { color:var(--accent-text); font-size:22px; }.more-platforms__detail { padding:13px 15px; color:var(--muted); font-size:11px; line-height:1.7; background:var(--surface-2); border-radius:0 0 14px 14px; }
