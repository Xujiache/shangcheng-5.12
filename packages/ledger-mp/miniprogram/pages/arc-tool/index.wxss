.arc {
  min-height: 100vh;
  color: var(--text);
}
.arc__page {
  padding-bottom: 118px;
}
.arc__sketch {
  height: 204px;
  margin-bottom: var(--gap);
  border-radius: 16px;
  background: var(--surface);
  box-shadow: var(--shadow-soft);
  overflow: hidden;
}
.arc__demo {
  width: 100%;
  height: 100%;
  display: block;
}
.arc__rule {
  margin: 0 4px var(--gap);
  color: #c24b63;
  font-size: 13.5px;
  line-height: 1.7;
}
.arc__gate {
  display: grid;
  grid-template-columns: 46px minmax(0, 1fr);
  gap: 12px;
  align-items: center;
  margin-bottom: var(--gap);
  padding: 18px;
}
.arc__gate-icon {
  width: 46px;
  height: 46px;
  border-radius: 14px;
  background: var(--accent-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}
.arc__gate-title {
  color: var(--text);
  font-size: 15px;
  font-weight: 800;
}
.arc__gate-text {
  margin-top: 4px;
  color: var(--muted);
  font-size: 12.5px;
  line-height: 1.65;
}
.arc__gate-cta {
  grid-column: 1 / -1;
  height: 40px;
  border-radius: 12px;
  background: var(--accent-soft);
  color: var(--accent-text);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13.5px;
  font-weight: 800;
}
.arc__title {
  margin: 18px 4px 10px;
  font-size: 18px;
  font-weight: 800;
  color: #1792b0;
}
.arc__label {
  flex: 0 0 auto;
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
}
.arc__input {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 15px;
  color: var(--text);
}
.arc__form--locked {
  opacity: 0.58;
}
.arc__input[disabled] {
  color: var(--faint);
}
.arc__value {
  font-size: 15px;
  font-weight: 700;
  color: var(--accent-text);
}
.arc__empty {
  padding: 26px 14px;
  text-align: center;
  font-size: 13.5px;
  color: var(--faint);
}
.arc__actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 80;
  display: flex;
  gap: 14px;
  padding: 12px 18px calc(12px + env(safe-area-inset-bottom));
  background: linear-gradient(
    180deg,
    rgba(235, 240, 237, 0) 0%,
    rgba(235, 240, 237, 0.96) 18%,
    rgba(235, 240, 237, 1) 100%
  );
  border-top: 1px solid var(--border);
}
.arc__btn {
  flex: 1;
  height: 48px;
  border-radius: 14px;
  border: 1px solid rgba(14, 124, 102, 0.35);
  background: var(--surface);
  color: var(--text);
  font-size: 15px;
  font-weight: 700;
}
.arc__btn--main {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
}
.arc__btn--locked {
  background: var(--accent-soft);
  color: var(--accent-text);
  border-color: rgba(14, 124, 102, 0.22);
}
.arc__btn[disabled] {
  opacity: 0.5;
  color: var(--faint);
}
.arc__btn::after {
  border: none;
}
