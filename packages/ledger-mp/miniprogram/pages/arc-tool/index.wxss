.arc {
  min-height: 100vh;
  color: var(--text);
}
.arc__sketch {
  position: relative;
  height: 230px;
  margin-bottom: var(--gap);
  border-radius: 16px;
  background: var(--surface);
  box-shadow: var(--shadow-soft);
  overflow: hidden;
}
.arc__curve {
  position: absolute;
  left: 48px;
  top: 30px;
  width: 264px;
  height: 154px;
  border-top: 3px solid #1f2522;
  border-radius: 50% 50% 0 0;
}
.arc__chord,
.arc__height,
.arc__left,
.arc__right {
  position: absolute;
  height: 2px;
  transform-origin: left center;
}
.arc__chord,
.arc__height {
  background: repeating-linear-gradient(90deg, #d9505f 0 8px, transparent 8px 15px);
}
.arc__chord {
  left: 54px;
  top: 132px;
  width: 254px;
}
.arc__height {
  left: 181px;
  top: 50px;
  width: 82px;
  transform: rotate(90deg);
}
.arc__left,
.arc__right {
  background: #1f2522;
  width: 154px;
}
.arc__left {
  left: 55px;
  top: 133px;
  transform: rotate(35deg);
}
.arc__right {
  left: 306px;
  top: 133px;
  transform: rotate(145deg);
}
.arc__angle {
  position: absolute;
  left: 159px;
  bottom: 34px;
  width: 46px;
  height: 24px;
  border-top: 3px solid #d9505f;
  border-radius: 50% 50% 0 0;
}
.arc__pt {
  position: absolute;
  font-size: 25px;
  font-weight: 800;
  color: #1f2522;
  font-family: Georgia, serif;
}
.arc__pt--A {
  left: 38px;
  top: 112px;
}
.arc__pt--B {
  left: 172px;
  top: 12px;
}
.arc__pt--C {
  right: 36px;
  top: 112px;
}
.arc__pt--D {
  left: 172px;
  top: 126px;
}
.arc__pt--a {
  left: 178px;
  bottom: 12px;
  font-size: 18px;
}
.arc__rule {
  margin: 0 4px var(--gap);
  color: #c24b63;
  font-size: 13.5px;
  line-height: 1.7;
}
.arc__title {
  margin: 18px 4px 10px;
  font-size: 18px;
  font-weight: 800;
  color: #1792b0;
}
.arc__label {
  flex: 0 0 auto;
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
}
.arc__input {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 15px;
  color: var(--text);
}
.arc__value {
  font-size: 15px;
  font-weight: 700;
  color: var(--accent-text);
}
.arc__empty {
  padding: 26px 14px;
  text-align: center;
  font-size: 13.5px;
  color: var(--faint);
}
.arc__actions {
  display: flex;
  gap: 14px;
  margin-top: 18px;
}
.arc__btn {
  flex: 1;
  height: 48px;
  border-radius: 14px;
  border: 1px solid rgba(14, 124, 102, 0.35);
  background: var(--surface);
  color: var(--text);
  font-size: 15px;
  font-weight: 700;
}
.arc__btn--main {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
}
.arc__btn::after {
  border: none;
}
