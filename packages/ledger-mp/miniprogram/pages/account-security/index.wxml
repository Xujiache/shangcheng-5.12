<lz-bg />
<view class="as">
  <lz-header title="账户安全" />

  <view class="lz-page" style="padding-bottom: 40px;">
    <view class="lz-section-label">微信账号</view>
    <view class="lz-card lz-card--flush">
      <view class="lz-row">
        <view class="lz-row__icon"><lz-icon name="wechat" size="17" color="#07C160" /></view>
        <view class="lz-row__main">
          <view class="lz-row__label">当前微信已登录</view>
          <view class="lz-row__sub">微信账号是门窗利账唯一登录方式</view>
        </view>
        <view class="lz-row__detail">已保护</view>
      </view>

      <view class="lz-row">
        <view class="lz-row__icon"><lz-icon name="shield" size="17" color="accent" /></view>
        <view class="lz-row__main">
          <view class="lz-row__label">账号编号</view>
          <view class="lz-row__sub">联系管理员开通会员时可提供此编号</view>
        </view>
        <view class="lz-row__detail">{{accountCode}}</view>
      </view>

      <view class="lz-row lz-row--last" hover-class="tap-active" bindtap="toDelete">
        <view class="lz-row__icon as__icon--danger"><lz-icon name="logout" size="17" color="loss" /></view>
        <view class="lz-row__main">
          <view class="lz-row__label lz-row__label--danger">注销账户</view>
          <view class="lz-row__sub">永久删除账号及全部数据</view>
        </view>
        <lz-icon name="chevron" size="16" color="faint" />
      </view>
    </view>

    <view class="as__note">门窗利账通过当前微信身份识别账号，使经营数据始终与同一微信账号保持对应。</view>
  </view>
</view>
