.home {
  min-height: 100vh;
  background: transparent;
}
.home__hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 18px 12px;
  /* 液态玻璃头部（首页自定义头，不走 lz-header）*/
  background: var(--glass-nav-bg);
  -webkit-backdrop-filter: var(--glass-blur-strong);
  backdrop-filter: var(--glass-blur-strong);
}
.home__title {
  font-size: 24px;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--text);
}
.home__sub {
  font-size: 13px;
  color: var(--muted);
  margin-top: 2px;
}
.home__bell {
  position: relative;
  width: 42px;
  height: 42px;
  border-radius: 999px;
  background: var(--surface);
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-soft);
}
.home__bell-image {
  display: block;
  width: 36px;
  height: 36px;
}
.home__dot {
  position: absolute;
  top: 9px;
  right: 10px;
  width: 8px;
  height: 8px;
  border-radius: 999px;
  background: var(--loss);
  border: 1.5px solid var(--surface);
}
.home__login-pill {
  min-width: 68px;
  height: 38px;
  padding: 0 14px;
  box-sizing: border-box;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: var(--surface);
  box-shadow: var(--shadow-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  color: var(--accent-text);
  font-size: 13.5px;
  font-weight: 700;
}
.home__hero {
  margin-bottom: var(--gap);
  overflow: hidden;
}
/* 性能模式：跟随手指的流体光晕 */
.home__touch {
  position: absolute;
  width: 240px;
  height: 240px;
  margin-left: -120px;
  margin-top: -120px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(46, 180, 150, 0.4) 0%, rgba(46, 180, 150, 0) 70%);
  pointer-events: none;
  transition: opacity 0.25s ease;
}
.home__hero-label {
  font-size: 13px;
  color: var(--muted);
}
.home__metrics {
  display: flex;
  margin-top: 18px;
  padding-top: 16px;
  border-top: 1px solid var(--border);
}
.home__metric {
  flex: 1;
  text-align: center;
}
.home__m-v {
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}
.home__m-l {
  font-size: 11px;
  color: var(--faint);
  margin-top: 3px;
}
.home__goal {
  margin-bottom: var(--gap);
}
.home__goal-t {
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
}
.home__goal-s {
  font-size: 11.5px;
  color: var(--faint);
  margin-top: 9px;
}
.home__card-t {
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
}
.home__cost {
  display: flex;
  align-items: center;
  gap: 16px;
}
.home__legend {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 9px;
}
.home__leg {
  display: flex;
  align-items: center;
  gap: 8px;
}
.home__leg-n {
  font-size: 12.5px;
  color: var(--muted);
}
.home__leg-p {
  font-size: 11px;
  color: var(--faint);
  margin-right: 8px;
}
.home__leg-v {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}
.home__rank {
  width: 22px;
  height: 22px;
  border-radius: 7px;
  background: var(--accent-soft);
  color: var(--accent-text);
  font-size: 12px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.home .lz-card {
  margin-bottom: var(--gap);
}

/* 广告轮播（#2）*/
.home__ads {
  width: 100%;
  height: 130px;
  border-radius: 16px;
  overflow: hidden;
  margin-bottom: var(--gap);
}
.home__ad-img {
  width: 100%;
  height: 130px;
  display: block;
}

/* 工具栏 */
.home__tool-head {
  margin: 2px 2px 10px;
  font-size: 13px;
  font-weight: 700;
  color: var(--muted);
  letter-spacing: 0.04em;
}
.home__tools {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  margin-bottom: var(--gap);
}
.home__tool-card {
  display: flex;
  min-width: 0;
  min-height: 112px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 13px 8px 12px;
  border-radius: 16px;
  background: var(--surface);
  box-shadow: var(--shadow-soft);
}
.home__tool-icon {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(14, 124, 102, 0.1);
}
.home__tool-image {
  width: 40px;
  height: 40px;
  display: block;
  flex: 0 0 auto;
}
.home__tool-icon--c2 {
  background: rgba(76, 159, 190, 0.12);
}
.home__tool-icon--c3 {
  background: rgba(223, 160, 58, 0.14);
}
.home__tool-t {
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
  white-space: nowrap;
}
.home__tool-s {
  font-size: 11.5px;
  color: var(--muted);
  white-space: nowrap;
}

/* 经营概览面板：周期控件 + 目标行 + 分析分组标题 */
.home__period {
  margin-bottom: 18px;
}
.home__goalrow {
  display: flex;
  align-items: center;
  margin-top: 18px;
  padding-top: 16px;
  border-top: 1px solid var(--border);
}
.home__section {
  font-size: 13px;
  font-weight: 700;
  color: var(--muted);
  letter-spacing: 0.04em;
  margin: 2px 2px 12px;
}
.home__subdiv {
  height: 1px;
  margin-top: 16px;
  background: var(--border);
}

/* 游客首页：公开能力直接可用，私有经营数据按需登录 */
.home__guest {
  display: flex;
  align-items: center;
  min-height: 84px;
  margin-bottom: var(--gap);
  padding: 16px;
  box-sizing: border-box;
  border: 1px solid rgba(255, 255, 255, 0.78);
  border-radius: 18px;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.94), rgba(241, 248, 245, 0.96));
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.9),
    0 8px 24px rgba(16, 40, 30, 0.08);
  transition:
    transform 180ms cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 180ms cubic-bezier(0.22, 1, 0.36, 1),
    background-color 180ms cubic-bezier(0.22, 1, 0.36, 1);
}
.home__guest--press {
  transform: scale(0.985);
  background: rgba(246, 250, 248, 0.98);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.82),
    0 3px 12px rgba(16, 40, 30, 0.08);
}
.home__guest-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  flex: 0 0 44px;
  border: 1px solid rgba(14, 124, 102, 0.09);
  border-radius: 14px;
  background: var(--accent-soft);
}
.home__guest-main {
  min-width: 0;
  flex: 1;
  margin-left: 12px;
}
.home__guest-title {
  color: var(--text);
  font-size: 16px;
  font-weight: 700;
  line-height: 1.35;
  white-space: nowrap;
}
.home__guest-copy {
  margin-top: 4px;
  color: var(--muted);
  font-size: 13.5px;
  line-height: 1.4;
  white-space: nowrap;
}
.home__guest-action {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-height: 44px;
  margin-left: 8px;
  flex-shrink: 0;
  gap: 1px;
  color: var(--accent-text);
  font-size: 13.5px;
  font-weight: 700;
  white-space: nowrap;
}
.home__public {
  margin-bottom: var(--gap);
}

@media (max-width: 350px) {
  .home__guest {
    padding: 14px;
  }
  .home__guest-icon {
    width: 40px;
    height: 40px;
    flex-basis: 40px;
    border-radius: 13px;
  }
  .home__guest-main {
    margin-left: 10px;
  }
  .home__guest-title {
    font-size: 15px;
  }
  .home__guest-copy,
  .home__guest-action {
    font-size: 12.5px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .home__guest {
    transition: none;
  }
}

/* 新版本更新日志弹窗 */
.clog-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(8, 20, 16, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32px;
}
.clog-pop {
  width: 100%;
  max-width: 340px;
  background: var(--surface);
  border-radius: 22px;
  padding: 24px 22px 20px;
  box-shadow: 0 20px 60px rgba(8, 24, 18, 0.35);
}
.clog-pop__ver {
  display: inline-block;
  font-size: 12.5px;
  font-weight: 800;
  color: var(--accent-text);
  background: var(--accent-soft);
  padding: 3px 11px;
  border-radius: 999px;
}
.clog-pop__title {
  font-size: 20px;
  font-weight: 800;
  color: var(--text);
  margin-top: 12px;
}
.clog-pop__sub {
  font-size: 12px;
  color: var(--faint);
  margin-top: 4px;
}
.clog-pop__body {
  max-height: 320px;
  margin: 14px 0 18px;
}
.clog-pop__line {
  font-size: 13.5px;
  color: var(--muted);
  line-height: 1.9;
}
