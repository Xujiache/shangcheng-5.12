<view class="wb overview lz-route-scene {{_routeMotion}}">
  <workbook-header title="记工台账" subtitle="每一份付出，都清清楚楚" back />
  <view class="wb-body">
    <view wx:if="{{error}}" class="overview-error">{{error}}</view>
    <view wx:if="{{cloudNotice}}" class="overview-notice" bindtap="cloudInfo" aria-role="button"
      ><workbook-icon name="info" size="15" color="muted" /><text>{{cloudNotice}}</text
      ><workbook-icon name="chevron" size="12" color="muted"
    /></view>
    <view class="overview-summary">
      <view class="overview-summary-heading"
        ><text>工资概览</text
        ><picker mode="date" fields="month" value="{{month}}" bindchange="monthChange"
          ><view class="overview-month"
            ><workbook-icon name="calendar" size="14" color="accent" /><text>{{month}}</text
            ><workbook-icon name="arrow-down" size="14" /></view></picker
      ></view>
      <view class="overview-earned-label">期间应计工资<text>含加班、奖扣及补差</text></view>
      <view class="overview-earned">{{earned}}</view>
      <view class="overview-quantities"
        ><text>{{recordCount}} 笔记工</text><text>{{days}} 工天</text
        ><text>{{hours}} 工时</text><text>{{pieces}} 件</text></view
      >
      <view class="overview-metrics">
        <view><text>期间已支付</text><view>{{paid}}</view></view>
        <view class="overview-metric-due"
          ><text>累计待支付</text><view>{{due}}</view></view
        >
        <view><text>累计已结算</text><view>{{settled}}</view></view>
        <view><text>未抵扣借支</text><view>{{advance}}</view></view>
      </view>
      <view class="overview-accounting">累计金额不按月份截断，借支不等于已发工资。</view>
      <button class="overview-add" style="width: 100%" bindtap="add">
        <workbook-icon name="plus" size="19" color="white" /><text>记一笔</text
        ><text class="overview-add-sub">支持多人批量</text>
      </button>
    </view>
    <view class="overview-section-heading"
      ><text>管理与对账</text><text class="overview-caption">建档 · 结算 · 报表</text></view
    >
    <view class="overview-tools">
      <view
        class="overview-tool"
        data-page="people"
        bindtap="go"
        hover-class="overview-pressed"
        aria-role="button"
        ><view class="overview-tool-icon"
          ><workbook-icon name="labor" size="22" color="accent" /></view
        ><text class="overview-tool-title">人员与工地</text
        ><text class="overview-tool-sub">{{workerCount}} 人 · {{projectCount}} 工地</text></view
      >
      <view
        class="overview-tool"
        data-page="finance"
        bindtap="go"
        hover-class="overview-pressed"
        aria-role="button"
        ><view class="overview-tool-icon"
          ><workbook-icon name="wallet" size="22" color="accent" /></view
        ><text class="overview-tool-title">工资结算</text
        ><text class="overview-tool-sub">借支与分次发薪</text></view
      >
      <view
        class="overview-tool"
        data-page="reports"
        bindtap="go"
        hover-class="overview-pressed"
        aria-role="button"
        ><view class="overview-tool-icon"
          ><workbook-icon name="profit" size="24" color="accent" /></view
        ><text class="overview-tool-title">报表与备份</text
        ><text class="overview-tool-sub">统计、导出与同步</text></view
      >
    </view>
    <view class="overview-section-heading"
      ><text>最近记工</text
      ><view class="overview-all" data-page="records" bindtap="go" aria-role="button"
        ><text>全部明细</text><workbook-icon name="chevron" size="12" color="accent" /></view
    ></view>
    <view class="overview-recent">
      <view wx:if="{{!recent.length}}" class="overview-empty"
        ><view class="overview-empty-icon"
          ><workbook-icon name="calendar" size="25" color="accent" /></view
        ><view class="overview-empty-title">从第一笔记工开始</view
        ><view class="overview-empty-description">{{workerCount?'记下出工与单价，工资自动汇总':'先建工人档案，再记录每天的出工'}}</view
        ><view class="overview-empty-action" bindtap="firstEntry" aria-role="button"
          >{{workerCount?'记第一笔':'添加工人'}}<workbook-icon name="chevron" size="12" color="accent" /></view
      ></view>
      <view
        wx:for="{{recent}}"
        wx:key="id"
        class="overview-record"
        data-id="{{item.id}}"
        bindtap="edit"
        hover-class="overview-pressed"
        aria-role="button"
        ><view class="overview-avatar">{{item.initial}}</view
        ><view class="overview-record-main"
          ><view class="overview-record-name">{{item.name}}</view
          ><view class="overview-record-meta">{{item.workDate}} · {{item.project}}</view></view
        ><view class="overview-record-amount">{{item.amount}}</view></view
      >
    </view>
    <view class="overview-storage" data-page="reports" bindtap="go" aria-role="button"
      ><workbook-icon name="shield" size="14" color="muted" /><view
        ><view>{{storageLabel}}</view><text>{{cloudBusy?'正在同步…':cloudNotice?'同步暂未完成，可到数据管理查看':'定期导出备份，妥善保管台账'}}</text
        ><text wx:if="{{pending}}"> · {{pending}} 次操作待同步</text></view
      ><workbook-icon name="chevron" size="12" color="muted"
    /></view>
  </view>
  <workbook-nav active="overview" />
</view>

<lz-route-feedback busy="{{_routeBusy}}" slow="{{_routeSlow}}" top="{{_routeTop}}" />
