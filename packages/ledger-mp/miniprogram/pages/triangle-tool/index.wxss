.geo {
  min-height: 100vh;
  color: var(--text);
}
.geo__sketch {
  position: relative;
  height: 210px;
  margin-bottom: var(--gap);
  border-radius: 16px;
  background: var(--surface);
  box-shadow: var(--shadow-soft);
  overflow: hidden;
}
.geo__rule {
  margin: 0 4px var(--gap);
  color: #c24b63;
  font-size: 13.5px;
  line-height: 1.7;
}
.geo__title {
  margin: 18px 4px 10px;
  font-size: 18px;
  font-weight: 800;
  color: #1792b0;
}
.geo__label {
  flex: 0 0 auto;
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
}
.geo__input {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 15px;
  color: var(--text);
}
.geo__value {
  font-size: 15px;
  font-weight: 700;
  color: var(--accent-text);
}
.geo__empty {
  padding: 26px 14px;
  text-align: center;
  font-size: 13.5px;
  color: var(--faint);
}
.geo__actions {
  display: flex;
  gap: 14px;
  margin-top: 18px;
}
.geo__btn {
  flex: 1;
  height: 48px;
  border-radius: 14px;
  border: 1px solid rgba(14, 124, 102, 0.35);
  background: var(--surface);
  color: var(--text);
  font-size: 15px;
  font-weight: 700;
}
.geo__btn--main {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
}
.geo__btn::after {
  border: none;
}

.tri__base,
.tri__left,
.tri__right,
.tri__height {
  position: absolute;
  height: 2px;
  background: #1f2522;
  transform-origin: left center;
}
.tri__base {
  left: 54px;
  bottom: 56px;
  width: 250px;
}
.tri__left {
  left: 54px;
  bottom: 56px;
  width: 238px;
  transform: rotate(-32deg);
}
.tri__right {
  left: 244px;
  bottom: 164px;
  width: 116px;
  transform: rotate(74deg);
}
.tri__height {
  left: 244px;
  bottom: 56px;
  width: 108px;
  transform: rotate(-90deg);
}
.tri__foot {
  position: absolute;
  left: 233px;
  bottom: 56px;
  width: 16px;
  height: 16px;
  border-left: 2px solid #1f2522;
  border-top: 2px solid #1f2522;
}
.tri__label,
.tri__pt {
  position: absolute;
  font-weight: 800;
  color: #1f2522;
}
.tri__label {
  font-size: 15px;
}
.tri__pt {
  font-size: 25px;
  font-family: Georgia, serif;
}
.tri__label--a {
  right: 54px;
  top: 94px;
}
.tri__label--b {
  left: 170px;
  bottom: 32px;
}
.tri__label--c {
  left: 138px;
  top: 76px;
}
.tri__label--h {
  left: 256px;
  top: 92px;
}
.tri__pt--A {
  left: 34px;
  bottom: 42px;
}
.tri__pt--B {
  left: 236px;
  top: 22px;
}
.tri__pt--C {
  right: 34px;
  bottom: 42px;
}
