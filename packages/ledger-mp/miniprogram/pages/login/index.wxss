.login {
  min-height: 100vh;
  padding: 0 28px;
  display: flex;
  flex-direction: column;
  background: transparent;
}
.login__brand {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.login__logo-img {
  width: 64%;
  height: 64%;
  border-radius: 14px;
}
.login__logo {
  width: 76px;
  height: 76px;
  border-radius: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #3ba58c, var(--accent));
  box-shadow: 0 16px 36px rgba(14, 124, 102, 0.3), inset 0 1px 1px rgba(255, 255, 255, 0.35);
}
.login__name {
  margin-top: 22px;
  color: var(--text);
  font-size: 30px;
  font-weight: 800;
  letter-spacing: -0.02em;
}
.login__slogan {
  margin-top: 8px;
  color: var(--muted);
  font-size: 15px;
}
.login__checking {
  display: flex;
  justify-content: center;
  padding: 64px 0;
  color: var(--muted);
  font-size: 15px;
}
.login__form {
  margin-top: 46px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.login__intro {
  padding: 0 4px 8px;
}
.login__intro-title {
  color: var(--text);
  font-size: 17px;
  font-weight: 700;
}
.login__intro-text {
  margin-top: 7px;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.6;
}
.login__privacy-tip,
.login__help {
  padding: 0 8px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.5;
  text-align: center;
}
.login__divider {
  margin: 8px 0 0;
  display: flex;
  align-items: center;
  gap: 12px;
}
.login__line {
  flex: 1;
  height: 1px;
  background: var(--border);
}
.login__divider text {
  color: var(--faint);
  font-size: 11.5px;
}
.login__agreement {
  margin-top: auto;
  padding: 20px 24px 30px;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 6px;
  color: var(--faint);
  font-size: 11.5px;
  line-height: 1.4;
}
.login__agreebox {
  flex: 0 0 auto;
  width: 16px;
  height: 16px;
  margin-top: 1px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1.5px solid var(--line, #d2dad6);
  border-radius: 5px;
  background: #fff;
}
.login__agreebox.on {
  border-color: var(--accent);
  background: var(--accent);
}
.login__agreetxt {
  flex: 1;
  max-width: 280px;
  text-align: left;
}
.login__link {
  color: var(--accent-text);
}
