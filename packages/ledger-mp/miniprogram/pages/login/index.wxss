.login {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  background: #fff;
}
.login__hero {
  position: relative;
  min-height: 440px;
  flex: 1 1 auto;
  overflow: hidden;
  background: #52bce5;
}
.login__hero-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.login__hero-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(7, 71, 94, 0.2) 0%, rgba(7, 71, 94, 0) 34%);
  pointer-events: none;
}
.login__hero-bridge {
  position: absolute;
  right: 0;
  bottom: -1px;
  left: 0;
  height: 54px;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0), #fff 72%);
  pointer-events: none;
}
.login__brand {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 14px);
  left: 20px;
}
.login__brand-mark {
  width: 46px;
  height: 46px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  box-sizing: border-box;
  border: 1px solid rgba(255, 255, 255, 0.5);
  border-radius: 14px;
  background: rgba(14, 124, 102, 0.92);
  box-shadow: 0 9px 22px rgba(7, 71, 94, 0.2);
}
.login__brand-logo {
  width: 68%;
  height: 68%;
  border-radius: 8px;
}
.login__sheet {
  position: relative;
  z-index: 2;
  min-height: 330px;
  margin-top: -2px;
  padding: 18px 28px calc(14px + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #fff;
}
.login__heading {
  margin-bottom: 22px;
  text-align: center;
}
.login__title {
  color: var(--text);
  font-size: 24px;
  font-weight: 800;
  line-height: 1.25;
  letter-spacing: 0;
}
.login__subtitle {
  margin-top: 8px;
  color: var(--muted);
  font-size: 13.5px;
  line-height: 1.45;
}
.login__primary-wrap {
  position: relative;
}
.login__recommend {
  position: absolute;
  top: -11px;
  right: 16px;
  z-index: 2;
  padding: 4px 9px;
  border-radius: 7px 7px 7px 2px;
  color: #fff;
  font-size: 10.5px;
  font-weight: 600;
  line-height: 1.2;
  background: #17352d;
  box-shadow: 0 5px 12px rgba(21, 32, 28, 0.18);
}
.login__primary,
.login__secondary {
  width: 100%;
  min-width: 100%;
  margin-right: 0;
  margin-left: 0;
  box-sizing: border-box;
  letter-spacing: 0;
}
.login__primary {
  height: 54px;
  border-radius: 15px;
  box-shadow: 0 10px 22px rgba(14, 124, 102, 0.25);
}
.login__secondary {
  height: 46px;
  margin-top: 11px;
  border-radius: 15px;
  background: #f6faf8;
  box-shadow: none;
}
.login__button-label {
  flex: 0 0 auto;
  white-space: nowrap;
}
.login__agreement {
  margin-top: 16px;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 7px;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.55;
}
.login__agreebox {
  width: 18px;
  height: 18px;
  margin-top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  box-sizing: border-box;
  border: 1.5px solid var(--border-strong);
  border-radius: 50%;
  background: #fff;
}
.login__agreebox.on {
  border-color: var(--accent);
  background: var(--accent);
}
.login__agreetxt {
  min-width: 0;
  max-width: 290px;
}
.login__link {
  color: var(--accent-text);
  font-weight: 600;
}
.login__sheet--checking {
  min-height: 250px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.login__checking {
  padding-bottom: 10px;
  text-align: center;
}
.login__checking-icon {
  width: 50px;
  height: 50px;
  margin: 0 auto 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16px;
  background: var(--accent-soft);
}
.login__checking-title {
  color: var(--text);
  font-size: 17px;
  font-weight: 700;
}
.login__checking-text {
  margin-top: 7px;
  color: var(--muted);
  font-size: 12.5px;
}

@media (max-height: 700px) {
  .login__hero {
    min-height: 330px;
  }
  .login__sheet {
    min-height: 316px;
    padding-top: 14px;
  }
  .login__heading {
    margin-bottom: 18px;
  }
  .login__title {
    font-size: 22px;
  }
  .login__subtitle {
    margin-top: 5px;
  }
  .login__agreement {
    margin-top: 13px;
  }
}
