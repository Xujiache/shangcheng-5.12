.login {
  min-height: 100vh;
  padding: 0 22px calc(18px + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: transparent;
}
.login__safe {
  height: calc(env(safe-area-inset-top) + 32px);
  flex: 0 0 auto;
}
.login__brand {
  display: flex;
  align-items: center;
  gap: 15px;
  flex: 0 0 auto;
}
.login__logo {
  width: 64px;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border-radius: 20px;
  background: linear-gradient(145deg, #3ba58c, var(--accent));
  box-shadow:
    0 14px 30px rgba(14, 124, 102, 0.24),
    inset 0 1px 1px rgba(255, 255, 255, 0.38);
}
.login__logo-img {
  width: 68%;
  height: 68%;
  border-radius: 12px;
}
.login__brand-copy {
  min-width: 0;
}
.login__name {
  color: var(--text);
  font-size: 27px;
  font-weight: 800;
  line-height: 1.16;
  letter-spacing: 0;
}
.login__slogan {
  margin-top: 7px;
  color: var(--muted);
  font-size: 13.5px;
  line-height: 1.4;
}
.login__main {
  min-height: 0;
  padding: 22px 0 16px;
  display: flex;
  align-items: center;
  flex: 1;
}
.login__panel {
  width: 100%;
  padding: 24px 20px 20px;
  box-sizing: border-box;
  border: 1px solid var(--glass-border);
  border-radius: 20px;
  background: var(--glass-card-bg);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  box-shadow:
    inset 0 1px 0 var(--glass-rim),
    0 18px 42px -20px rgba(8, 24, 18, 0.28);
}
.login__intro {
  margin-bottom: 18px;
}
.login__intro-title {
  color: var(--text);
  font-size: 20px;
  font-weight: 700;
  line-height: 1.3;
}
.login__intro-text {
  margin-top: 7px;
  color: var(--muted);
  font-size: 13.5px;
  line-height: 1.55;
}
.login__agreement {
  margin-bottom: 18px;
  display: flex;
  align-items: flex-start;
  gap: 8px;
  color: var(--muted);
  font-size: 11.5px;
  line-height: 1.58;
}
.login__agreebox {
  width: 18px;
  height: 18px;
  margin-top: 1px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  box-sizing: border-box;
  border: 1.5px solid var(--border-strong);
  border-radius: 5px;
  background: rgba(255, 255, 255, 0.82);
}
.login__agreebox.on {
  border-color: var(--accent);
  background: var(--accent);
}
.login__agreetxt {
  min-width: 0;
  flex: 1;
}
.login__link {
  color: var(--accent-text);
  font-weight: 600;
}
.login__primary {
  width: 100%;
  min-width: 100%;
  height: 56px;
  margin-right: 0;
  margin-left: 0;
  box-sizing: border-box;
  letter-spacing: 0;
  box-shadow: 0 10px 24px rgba(14, 124, 102, 0.3);
}
.login__button-label {
  flex: 0 0 auto;
  white-space: nowrap;
}
.login__privacy-tip {
  margin-top: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.4;
}
.login__divider {
  margin: 17px 0 14px;
  display: flex;
  align-items: center;
  gap: 12px;
}
.login__line {
  height: 1px;
  flex: 1;
  background: var(--border);
}
.login__divider-label {
  color: var(--faint);
  font-size: 11.5px;
}
.login__secondary {
  width: 100%;
  min-width: 100%;
  height: 50px;
  margin-right: 0;
  margin-left: 0;
  box-sizing: border-box;
  letter-spacing: 0;
  background: rgba(255, 255, 255, 0.84);
}
.login__help {
  margin-top: 10px;
  padding: 0 6px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.5;
  text-align: center;
}
.login__footnote {
  min-height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  flex: 0 0 auto;
  color: var(--faint);
  font-size: 11.5px;
}
.login__panel--checking {
  padding-top: 34px;
  padding-bottom: 34px;
  text-align: center;
}
.login__checking-icon {
  width: 48px;
  height: 48px;
  margin: 0 auto 15px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 15px;
  background: var(--accent-soft);
}
.login__checking-title {
  color: var(--text);
  font-size: 16px;
  font-weight: 700;
}
.login__checking-text {
  margin-top: 6px;
  color: var(--muted);
  font-size: 12.5px;
}

@media (max-height: 700px) {
  .login__safe {
    height: calc(env(safe-area-inset-top) + 20px);
  }
  .login__logo {
    width: 56px;
    height: 56px;
    border-radius: 17px;
  }
  .login__name {
    font-size: 24px;
  }
  .login__main {
    padding: 14px 0 10px;
  }
  .login__panel {
    padding: 18px 16px 16px;
  }
  .login__intro,
  .login__agreement {
    margin-bottom: 13px;
  }
  .login__divider {
    margin: 13px 0 11px;
  }
  .login__help {
    margin-top: 7px;
  }
}
