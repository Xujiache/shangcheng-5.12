<lz-bg />
<view class="login">
  <view style="height: calc(env(safe-area-inset-top) + 50px);"></view>

  <!-- 品牌 -->
  <view class="login__brand">
    <view class="login__logo">
      <image wx:if="{{logoUrl}}" class="login__logo-img" src="{{logoUrl}}" mode="aspectFit" />
      <lz-icon wx:else name="cube" size="40" color="white" stroke="2" />
    </view>
    <view class="login__name">门窗利账</view>
    <view class="login__slogan">使用微信手机号授权登录</view>
  </view>

  <!-- 静默登录校验中：显示占位，不露出表单（避免每次启动闪登录页） -->
  <view
    wx:if="{{checking}}"
    class="login__checking"
    style="display: flex; justify-content: center; padding: 64px 0;"
  >
    <text style="color: var(--muted); font-size: 15px;">正在进入…</text>
  </view>

  <!-- 登录 -->
  <view wx:else class="login__form">
    <view class="login__notice">
      <view class="login__notice-title">管理员已开通账号后可登录</view>
      <view class="login__notice-text">
        点击下方按钮后，微信会弹出手机号授权。手机号仅用于匹配管理员已开通的门窗利账账号，不会用于公开展示或营销。
      </view>
    </view>

    <button
      wx:if="{{agreed}}"
      class="lz-btn lz-btn--primary lz-btn--lg lz-btn--full"
      open-type="getPhoneNumber"
      bindgetphonenumber="onPhoneLogin"
      phone-number-no-quota-toast="手机号授权次数不足，请联系管理员"
    >
      {{loading ? '登录中…' : '微信手机号授权登录'}}
    </button>
    <button
      wx:else
      class="lz-btn lz-btn--primary lz-btn--lg lz-btn--full lz-btn--disabled"
      bindtap="promptAgreement"
    >
      微信手机号授权登录
    </button>

    <view class="login__help">未开通账号或手机号不匹配，请联系管理员处理。</view>
  </view>

  <view wx:if="{{!checking}}" class="login__agreement" bindtap="toggleAgree">
    <view class="login__agreebox {{agreed ? 'on' : ''}}">
      <lz-icon wx:if="{{agreed}}" name="check" size="12" color="white" stroke="2.5" />
    </view>
    <view class="login__agreetxt">
      已阅读并同意
      <text class="login__link" catchtap="onDoc" data-key="terms">《用户协议》</text>
      与
      <text class="login__link" catchtap="onDoc" data-key="privacy">《隐私政策》</text>
    </view>
  </view>
</view>
