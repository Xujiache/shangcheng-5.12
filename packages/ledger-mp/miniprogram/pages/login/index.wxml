<view class="login">
  <view class="login__hero">
    <image class="login__hero-image" src="/assets/login/login-hero.jpg" mode="aspectFill" />
    <view class="login__hero-shade"></view>
    <view class="login__hero-bridge"></view>
    <view class="login__brand">
      <view class="login__brand-mark">
        <image wx:if="{{logoUrl}}" class="login__brand-logo" src="{{logoUrl}}" mode="aspectFit" />
        <lz-icon wx:else name="cube" size="25" color="white" stroke="2" />
      </view>
    </view>
  </view>

  <view class="login__sheet {{checking ? 'login__sheet--checking' : ''}}">
    <view wx:if="{{checking}}" class="login__checking">
      <view class="login__checking-icon">
        <lz-icon name="shield" size="25" color="accent" stroke="1.8" />
      </view>
      <view class="login__checking-title">正在验证登录状态</view>
      <view class="login__checking-text">请稍候，即将进入你的账本</view>
    </view>

    <block wx:else>
      <view class="login__heading">
        <view class="login__title">微信快捷登录</view>
        <view class="login__subtitle">登录后同步订单、客户与利润数据</view>
      </view>

      <view class="login__primary-wrap">
        <view class="login__recommend">推荐使用</view>
        <button
          wx:if="{{agreed}}"
          id="privacy-phone-login"
          class="lz-btn lz-btn--primary lz-btn--full login__primary {{loading ? 'lz-btn--disabled' : ''}}"
          open-type="getPhoneNumber|agreePrivacyAuthorization"
          bindgetphonenumber="onPhoneLogin"
          bindagreeprivacyauthorization="onPrivacyAuthorized"
          phone-number-no-quota-toast="手机号快速验证次数不足，请稍后重试或联系管理员"
        >
          <lz-icon name="phone" size="20" color="white" stroke="2" />
          <text class="login__button-label">{{loading ? '登录中…' : '手机号快捷登录'}}</text>
        </button>
        <button
          wx:else
          class="lz-btn lz-btn--primary lz-btn--full login__primary"
          bindtap="ensureAgreed"
        >
          <lz-icon name="phone" size="20" color="white" stroke="2" />
          <text class="login__button-label">手机号快捷登录</text>
        </button>
      </view>

      <button
        class="lz-btn lz-btn--ghost lz-btn--full login__secondary {{loading ? 'lz-btn--disabled' : ''}}"
        bindtap="onWechatLogin"
      >
        <lz-icon name="wechat" size="20" color="#07C160" stroke="1.9" />
        <text class="login__button-label">微信登录</text>
      </button>

      <view class="login__agreement" bindtap="toggleAgree">
        <view class="login__agreebox {{agreed ? 'on' : ''}}">
          <lz-icon wx:if="{{agreed}}" name="check" size="12" color="white" stroke="2.5" />
        </view>
        <view class="login__agreetxt">
          我已阅读并同意
          <text class="login__link" catchtap="onDoc" data-key="terms">《用户协议》</text>
          <text class="login__link" catchtap="onDoc" data-key="privacy">《隐私政策》</text>
          和
          <text class="login__link" catchtap="openPrivacyContract">{{privacyContractName}}</text>
        </view>
      </view>

    </block>
  </view>
</view>
