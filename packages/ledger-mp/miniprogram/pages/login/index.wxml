<lz-bg />
<view class="login">
  <view class="login__safe"></view>

  <view class="login__brand">
    <view class="login__logo">
      <image wx:if="{{logoUrl}}" class="login__logo-img" src="{{logoUrl}}" mode="aspectFit" />
      <lz-icon wx:else name="cube" size="34" color="white" stroke="2" />
    </view>
    <view class="login__brand-copy">
      <view class="login__name">门窗利账</view>
      <view class="login__slogan">订单、利润与客户，一处管理</view>
    </view>
  </view>

  <view wx:if="{{checking}}" class="login__main">
    <view class="login__panel login__panel--checking">
      <view class="login__checking-icon">
        <lz-icon name="shield" size="24" color="accent" stroke="1.8" />
      </view>
      <view class="login__checking-title">正在验证登录状态</view>
      <view class="login__checking-text">请稍候，即将进入你的账本</view>
    </view>
  </view>

  <view wx:else class="login__main">
    <view class="login__panel">
      <view class="login__intro">
        <view class="login__intro-title">登录门窗利账</view>
        <view class="login__intro-text">使用管理员已开通的微信手机号快速进入</view>
      </view>

      <view class="login__agreement" bindtap="toggleAgree">
        <view class="login__agreebox {{agreed ? 'on' : ''}}">
          <lz-icon wx:if="{{agreed}}" name="check" size="12" color="white" stroke="2.5" />
        </view>
        <view class="login__agreetxt">
          我已阅读并同意
          <text class="login__link" catchtap="onDoc" data-key="terms">《用户协议》</text>
          <text class="login__link" catchtap="onDoc" data-key="privacy">《隐私政策》</text>
          和
          <text class="login__link" catchtap="openPrivacyContract">{{privacyContractName}}</text>
        </view>
      </view>

      <button
        wx:if="{{agreed}}"
        id="privacy-phone-login"
        class="lz-btn lz-btn--primary lz-btn--lg lz-btn--full login__primary {{loading ? 'lz-btn--disabled' : ''}}"
        open-type="getPhoneNumber|agreePrivacyAuthorization"
        bindgetphonenumber="onPhoneLogin"
        bindagreeprivacyauthorization="onPrivacyAuthorized"
        phone-number-no-quota-toast="手机号快速验证次数不足，请稍后重试或联系管理员"
      >
        <lz-icon name="phone" size="20" color="white" stroke="2" />
        <text class="login__button-label">{{loading ? '登录中…' : '微信手机号快捷登录'}}</text>
      </button>
      <button
        wx:else
        class="lz-btn lz-btn--primary lz-btn--lg lz-btn--full login__primary"
        bindtap="ensureAgreed"
      >
        <lz-icon name="phone" size="20" color="white" stroke="2" />
        <text class="login__button-label">微信手机号快捷登录</text>
      </button>

      <view class="login__privacy-tip">
        <lz-icon name="shield" size="13" color="accent" stroke="1.8" />
        <text>手机号仅用于账号识别和安全校验</text>
      </view>

      <view class="login__divider">
        <view class="login__line"></view>
        <text class="login__divider-label">其他方式</text>
        <view class="login__line"></view>
      </view>

      <button
        class="lz-btn lz-btn--ghost lz-btn--full login__secondary {{loading ? 'lz-btn--disabled' : ''}}"
        bindtap="onWechatLogin"
      >
        <lz-icon name="wechat" size="20" color="#07C160" stroke="1.9" />
        <text class="login__button-label">微信登录</text>
      </button>
      <view class="login__help">完成一次手机号快捷登录后，下次可直接使用微信登录</view>
    </view>
  </view>

  <view wx:if="{{!checking}}" class="login__footnote">
    <lz-icon name="shield" size="14" color="faint" stroke="1.7" />
    <text>账号由管理员统一开通</text>
  </view>
</view>
