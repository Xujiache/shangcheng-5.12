<lz-bg />
<view class="login">
  <view style="height: calc(env(safe-area-inset-top) + 50px);"></view>

  <view class="login__brand">
    <view class="login__logo">
      <image wx:if="{{logoUrl}}" class="login__logo-img" src="{{logoUrl}}" mode="aspectFit" />
      <lz-icon wx:else name="cube" size="40" color="white" stroke="2" />
    </view>
    <view class="login__name">门窗利账</view>
    <view class="login__slogan">微信快捷登录，管理订单与利润</view>
  </view>

  <view wx:if="{{checking}}" class="login__checking">
    <text>正在进入…</text>
  </view>

  <view wx:else class="login__form">
    <view class="login__intro">
      <view class="login__intro-title">微信手机号快捷登录</view>
      <view class="login__intro-text">识别管理员已开通的手机号，并自动绑定当前微信</view>
    </view>

    <button
      wx:if="{{agreed}}"
      class="lz-btn lz-btn--primary lz-btn--lg lz-btn--full {{loading ? 'lz-btn--disabled' : ''}}"
      open-type="getPhoneNumber"
      bindgetphonenumber="onPhoneLogin"
      phone-number-no-quota-toast="手机号快速验证次数不足，请稍后重试或联系管理员"
    >
      <lz-icon name="phone" size="20" color="white" stroke="2" />
      <text>{{loading ? '登录中…' : '微信手机号快捷登录'}}</text>
    </button>
    <button wx:else class="lz-btn lz-btn--primary lz-btn--lg lz-btn--full" bindtap="ensureAgreed">
      <lz-icon name="phone" size="20" color="white" stroke="2" />
      <text>微信手机号快捷登录</text>
    </button>
    <view class="login__privacy-tip">手机号仅用于匹配已开通账号和保障账号安全</view>

    <view class="login__divider">
      <view class="login__line"></view>
      <text>其他方式</text>
      <view class="login__line"></view>
    </view>
    <button
      class="lz-btn lz-btn--ghost lz-btn--full {{loading ? 'lz-btn--disabled' : ''}}"
      bindtap="onWechatLogin"
    >
      <lz-icon name="wechat" size="20" color="#07C160" stroke="1.9" />
      <text>微信登录</text>
    </button>
    <view class="login__help">完成一次手机号快捷登录后，下次可直接使用微信登录</view>
  </view>

  <view wx:if="{{!checking}}" class="login__agreement" bindtap="toggleAgree">
    <view class="login__agreebox {{agreed ? 'on' : ''}}">
      <lz-icon wx:if="{{agreed}}" name="check" size="12" color="white" stroke="2.5" />
    </view>
    <view class="login__agreetxt">
      已阅读并同意
      <text class="login__link" catchtap="onDoc" data-key="terms">《用户协议》</text>
      与
      <text class="login__link" catchtap="onDoc" data-key="privacy">《隐私政策》</text>
    </view>
  </view>
</view>
