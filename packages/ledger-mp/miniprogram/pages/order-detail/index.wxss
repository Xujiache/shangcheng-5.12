.od__edit {
  font-size: 15px;
  font-weight: 600;
  color: var(--accent-text);
}
.od__core {
  display: flex;
  align-items: center;
  gap: 16px;
}
.od__core-r {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.od__core-row {
  display: flex;
  gap: 24px;
}
.od__lbl {
  font-size: 12px;
  color: var(--muted);
  margin-bottom: 2px;
}
.od__val {
  font-size: 14.5px;
  font-weight: 600;
  color: var(--text);
}
.od__val--link {
  color: var(--accent-text);
  margin-right: 4px;
}
.od__t {
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 14px;
}
.od__cost {
  display: flex;
  align-items: center;
  gap: 11px;
  margin-bottom: 13px;
}
.od__c-name {
  font-size: 13.5px;
  width: 34px;
  flex-shrink: 0;
}
.od__c-pct {
  font-size: 11.5px;
  color: var(--faint);
  width: 32px;
  text-align: right;
}
.od__c-val {
  font-size: 13.5px;
  font-weight: 600;
  width: 64px;
  text-align: right;
  font-variant-numeric: tabular-nums;
}
.od__ex {
  min-height: 38px;
}
/* 备注独立成块：标签在上、内容整行换行，长备注不挤压标签 */
.od__note {
  padding: 14px 0;
}
.od__note-val {
  font-size: 14px;
  font-weight: 500;
  color: var(--text);
  margin-top: 6px;
  line-height: 1.6;
  word-break: break-all;
}
/* 报价明细行 */
.od__item {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 13px;
}
.od__item:last-child {
  margin-bottom: 0;
}
.od__item-main {
  flex: 1;
  min-width: 0;
}
.od__item-name {
  font-size: 13.5px;
  font-weight: 600;
}
.od__item-spec {
  font-size: 11.5px;
  color: var(--faint);
  margin-top: 2px;
}
.od__item-val {
  font-size: 13.5px;
  font-weight: 600;
  text-align: right;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}
.od__share {
  flex: 0 0 110px;
}
.od__pdf-mask {
  position: fixed;
  z-index: 100;
  right: 0;
  bottom: 0;
  left: 0;
  top: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(21, 32, 28, 0.42);
}
.od__pdf-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 22px 20px calc(16px + env(safe-area-inset-bottom));
  border-radius: 24px 24px 0 0;
  background: rgba(247, 252, 249, 0.98);
  box-shadow: 0 -12px 34px rgba(21, 82, 65, 0.18);
  text-align: center;
}
.od__pdf-sheet-title {
  color: var(--text);
  font-size: 19px;
  font-weight: 800;
}
.od__pdf-sheet-hint {
  margin: 8px 0 16px;
  color: var(--muted);
  font-size: 13px;
}
.od__pdf-share-btn {
  width: 100%;
  margin: 0;
}
.od__pdf-cancel {
  padding-top: 14px;
  color: var(--muted);
  font-size: 13px;
}
/* 离屏报价画布：移出可视区但仍需保留渲染节点，供 canvasToTempFilePath 读取。 */
.od__export-canvas {
  position: fixed;
  left: 0;
  top: 0;
  z-index: -1;
  width: 2px;
  height: 2px;
  opacity: 0.01;
  pointer-events: none;
}
