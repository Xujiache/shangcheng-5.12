<lz-bg />
<view class="prof tab-page {{tabMotion ? 'tab-page--motion-b' : 'tab-page--motion-a'}}" style="{{glassCard}}">
  <view style="height: {{topSpace}}px;"></view>

  <view class="lz-page lz-page--pad-bottom">
    <block wx:if="{{isGuest}}">
      <view class="prof__user lz-card lz-card--glow">
        <view class="lz-avatar prof__avatar">访</view>
        <view class="lz-flex1" style="min-width: 0;">
          <view class="prof__name">游客模式</view>
          <view class="prof__account">{{accountText}}</view>
        </view>
        <view class="lz-btn lz-btn--soft lz-btn--sm" hover-class="tap-active" bindtap="toLogin">去登录</view>
      </view>

      <view class="lz-card prof__guest-card">
        <view class="prof__guest-title">你的经营数据只在登录后读取</view>
        <view class="prof__guest-copy">暂不登录可浏览下方公开页面；订单、报表及计算功能需登录并开通有效会员。</view>
        <button class="lz-btn lz-btn--primary lz-btn--lg lz-btn--full prof__guest-login" bindtap="toLogin">登录并进入我的账本</button>
      </view>

      <view class="lz-section-label">免登录浏览</view>
      <view class="lz-card lz-card--flush prof__grid">
        <view class="prof__grid-cell" data-page="/pages/triangle-tool/index" bindtap="toPublicPage" hover-class="tap-active">
          <view class="prof__grid-ic"><image class="prof__grid-icon-img" src="/assets/tools/tool-triangle.png" mode="aspectFit" /></view>
          <view class="prof__grid-t">三角计算</view>
        </view>
        <view class="prof__grid-cell" data-page="/pages/arc-tool/index" bindtap="toPublicPage" hover-class="tap-active">
          <view class="prof__grid-ic"><image class="prof__grid-icon-img" src="/assets/tools/tool-arc.png" mode="aspectFit" /></view>
          <view class="prof__grid-t">圆弧计算</view>
        </view>
        <view class="prof__grid-cell" data-page="/pages/about/index" bindtap="toPublicPage" hover-class="tap-active">
          <view class="prof__grid-ic"><lz-icon name="info" size="24" color="accent" /></view>
          <view class="prof__grid-t">关于产品</view>
        </view>
        <view class="prof__grid-cell" data-page="/pages/doc/index?key=privacy" bindtap="toPublicPage" hover-class="tap-active">
          <view class="prof__grid-ic"><lz-icon name="shield" size="24" color="accent" /></view>
          <view class="prof__grid-t">隐私政策</view>
        </view>
      </view>
    </block>

    <block wx:else>
    <!-- 用户卡 -->
    <view class="prof__user lz-card lz-card--glow">
      <image
        wx:if="{{avatarUrl}}"
        class="lz-avatar prof__avatar"
        src="{{avatarUrl}}"
        mode="aspectFill"
      />
      <view wx:else class="lz-avatar prof__avatar">{{avatarChar}}</view>
      <view class="lz-flex1" style="min-width: 0;">
        <view class="prof__name">{{nickname}}</view>
        <view class="prof__account">{{accountText}}</view>
      </view>
      <view class="lz-btn lz-btn--soft lz-btn--sm" hover-class="tap-active" bindtap="toEdit">编辑资料</view>
    </view>

    <!-- 会员卡 -->
    <view class="prof__member {{memberActive ? 'prof__member--on' : ''}}" hover-class="tap-active" bindtap="toMembership">
      <view class="prof__m-icon">
        <image class="prof__m-icon-img" src="/assets/profile/profile-member.png" mode="aspectFit" />
      </view>
      <view class="lz-flex1" style="min-width: 0;">
        <view class="prof__m-t">{{memberText}}</view>
        <view class="prof__m-s">{{memberSub}}</view>
      </view>
      <view class="prof__m-cta">{{memberActive ? '续费' : '开通'}}</view>
      <lz-icon name="chevron" size="16" color="{{memberActive ? '#C9A24B' : 'faint'}}" />
    </view>

    <!-- 常用功能 -->
    <view class="lz-section-label">常用功能</view>
    <view class="lz-card lz-card--flush prof__grid">
      <view class="prof__grid-cell" data-page="/pages/customers/index" bindtap="toRow" hover-class="tap-active">
        <view class="prof__grid-ic">
          <image class="prof__grid-icon-img" src="/assets/profile/profile-customers.png" mode="aspectFit" />
        </view>
        <view class="prof__grid-t">客户管理</view>
      </view>
      <view class="prof__grid-cell" data-page="/pages/cut/index" bindtap="toRow" hover-class="tap-active">
        <view class="prof__grid-ic">
          <image class="prof__grid-icon-img" src="/assets/tools/tool-cut.png" mode="aspectFit" />
        </view>
        <view class="prof__grid-t">优化下料</view>
      </view>
      <view class="prof__grid-cell" data-page="/pages/goal/index" bindtap="toRow" hover-class="tap-active">
        <view class="prof__grid-ic">
          <image class="prof__grid-icon-img" src="/assets/profile/profile-goal.png" mode="aspectFit" />
        </view>
        <view class="prof__grid-t">经营目标</view>
      </view>
      <view class="prof__grid-cell" data-page="/pages/message-center/index" bindtap="toRow" hover-class="tap-active">
        <view class="prof__grid-ic">
          <image class="prof__grid-icon-img" src="/assets/profile/profile-message.png" mode="aspectFit" />
        </view>
        <view class="prof__grid-t">消息中心</view>
      </view>
    </view>

    <!-- 设置 -->
    <view class="lz-section-label" style="margin-top: var(--gap);">设置</view>
    <view class="lz-card lz-card--flush">
      <view wx:for="{{rows}}" wx:key="page" class="lz-row" data-page="{{item.page}}" bindtap="toRow" hover-class="tap-active">
        <view class="lz-row__icon">
          <image class="prof__row-icon-img" src="{{item.iconSrc}}" mode="aspectFit" />
        </view>
        <view class="lz-row__main"><view class="lz-row__label">{{item.label}}</view></view>
        <lz-icon name="chevron" size="17" color="faint" />
      </view>
    </view>

    <view style="height: 24px;"></view>
    <view class="lz-btn lz-btn--ghost lz-btn--full" hover-class="tap-active" bindtap="onLogout">
      <lz-icon name="logout" size="18" color="loss" />
      <text style="color: var(--loss);">退出登录</text>
    </view>
    </block>
  </view>
  <canvas type="2d" id="shareCover" class="share-cover-cv"></canvas>
</view>
