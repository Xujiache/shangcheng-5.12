@import '../common.wxss';
.metal-home__utility { display: flex; margin-bottom: 12px; }
.metal-home__shortcut { flex: 1; display: flex; align-items: center; justify-content: space-between; gap: 6px; min-width: 0; min-height: 72px; padding: 12px 14px; }
.metal-home__shortcut + .metal-home__shortcut { border-left: 1px solid var(--border); }
.metal-home__shortcut-title { display: block; margin-bottom: 4px; font-size: 14px; font-weight: 600; }
.metal-home__chevron { color: var(--faint); font-size: 23px; }
.metal-home__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--border); }
.metal-home__category { display: flex; flex-direction: column; align-items: center; min-width: 0; min-height: 124px; padding: 14px 5px 12px; }
.metal-home__category:nth-child(3n + 2), .metal-home__category:nth-child(3n + 3) { border-left: 1px solid var(--border); }
.metal-home__category:nth-child(n + 4) { border-top: 1px solid var(--border); }
.metal-home__icon { display: block; width: 44px; height: 34px; }
.metal-home__name { margin-top: 9px; font-size: 15px; font-weight: 600; }
.metal-home__summary { margin-top: 4px; color: var(--muted); font-size: 11px; text-align: center; }
.metal-home__unit { margin-top: 3px; color: var(--faint); font-size: 11px; }
.metal-home__help { margin-top: 12px; }
.metal-home__help-row { display: flex; align-items: flex-start; gap: 12px; padding: 9px 14px; border-top: 1px solid var(--border); font-size: 12px; line-height: 1.5; }
.metal-home__help-row text:first-child { flex: 0 0 48px; color: var(--text); }
.metal-home__help-row text:last-child { flex: 1; color: var(--muted); }
.metal-home__foot { display: flex; justify-content: space-between; align-items: center; min-height: 42px; padding: 0 4px; color: var(--faint); font-size: 11px; }
