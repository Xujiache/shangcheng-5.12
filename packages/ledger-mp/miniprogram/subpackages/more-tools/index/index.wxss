.more-page { min-height: 100vh; }
.more-page__body { padding: 14px 16px calc(34px + env(safe-area-inset-bottom)); }
.more-page__search { height: 44px; display: flex; align-items: center; gap: 8px; padding: 0 13px; border: 1px solid var(--border); border-radius: 13px; background: var(--surface); }
.more-page__search-icon { color: var(--muted); font-size: 25px; line-height: 1; }
.more-page__search input { flex: 1; min-width: 0; height: 100%; color: var(--text); font-size: 13px; }
.more-page__clear { width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 22px; }
.more-page__heading { margin: 26px 2px 10px; color: var(--muted); font-size: 13px; font-weight: 700; letter-spacing: .04em; }
.more-page__heading--other { margin-top: 22px; }
.more-page__grid { display: flex; flex-wrap: wrap; padding: 14px 4px 12px; background: var(--surface); border: 1px solid var(--border); border-radius: 18px; box-shadow: var(--shadow-soft); }
.more-page__item { width: 20%; min-width: 0; min-height: 88px; padding: 5px 1px; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; border-radius: 12px; }
.more-page__item image { width: 42px; height: 42px; flex: 0 0 auto; }
.more-page__item text { margin-top: 6px; width: 100%; color: var(--text); font-size: 10px; line-height: 15px; font-weight: 700; text-align: center; white-space: pre-line; word-break: break-all; }
.more-page__empty { margin-top: 28px; padding: 36px 12px; text-align: center; border-radius: 18px; background: var(--surface); color: var(--text); font-weight: 700; }
.more-page__empty text { display: block; margin-top: 7px; color: var(--muted); font-size: 12px; font-weight: 400; }
.more-page__empty button { width: 108px; height: 34px; margin-top: 18px; border: 1px solid var(--border); border-radius: 10px; background: transparent; color: var(--accent-text); font-size: 12px; }
.more-page__foot { padding: 23px 0; color: var(--faint); font-size: 11px; text-align: center; }
