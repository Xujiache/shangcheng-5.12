@import "../common.wxss";
.level-card { margin-top: 14px; padding: 18px 16px 20px; text-align: center; }
.level-status { display: flex; align-items: center; justify-content: center; gap: 6px; color: var(--muted); font-size: 11px; }
.level-status__dot { width: 6px; height: 6px; border-radius: 50%; background: #35b68c; }
.level-status--error .level-status__dot { background: #c85a49; }
.level-dial { position: relative; width: 210px; height: 210px; margin: 20px auto 13px; border: 1px solid #d5e7dc; border-radius: 50%; background: radial-gradient(circle, #fbfffb 0, #f3faf3 50%, #eaf5ed 100%); box-shadow: inset 0 4px 16px rgba(20, 88, 61, .06); overflow: hidden; }
.level-dial__ring { position: absolute; inset: 42px; border: 1px solid #c9e4d2; border-radius: 50%; }
.level-dial__axis { position: absolute; z-index: 1; background: #d9e9df; }
.level-dial__axis--x { left: 0; right: 0; top: 50%; height: 1px; }
.level-dial__axis--y { top: 0; bottom: 0; left: 50%; width: 1px; }
.level-dial__bubble { position: absolute; z-index: 2; left: 50%; top: 50%; width: 42px; height: 42px; margin: -21px 0 0 -21px; border: 1px solid #5aaa83; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #dbffea 0, #7bcaa4 54%, #278868 100%); box-shadow: 0 5px 11px rgba(15, 117, 72, .2); }
.level-slope { position: relative; height: 210px; margin: 20px 0 13px; overflow: hidden; }
.level-slope__line { position: absolute; left: 11%; top: 50%; width: 78%; height: 9px; border-radius: 999px; background: linear-gradient(90deg, #9fd6b9, #0e7c66); transform-origin: center; }
.level-slope__base { position: absolute; left: 11%; right: 11%; top: 50%; height: 1px; background: #d8e5dc; }
.level-value { color: var(--accent-text); font-size: 38px; line-height: 1; font-weight: 800; font-variant-numeric: tabular-nums; }
.level-value text { margin-left: 2px; font-size: 22px; }
.level-caption { margin-top: 7px; color: var(--muted); font-size: 11px; }
.level-axes { display: flex; margin-top: 23px; border-top: 1px solid var(--border); padding-top: 14px; }
.level-axes view { flex: 1; display: flex; flex-direction: column; gap: 5px; }
.level-axes view:first-child { border-right: 1px solid var(--border); }
.level-axes text { color: var(--faint); font-size: 11px; }
.level-axes__value { color: var(--text); font-size: 14px; font-weight: 700; }
.level-buttons { display: flex; gap: 10px; }
.level-buttons button { flex: 1; margin-top: 0; }
.level-note { margin: 17px 3px; }
.level-unavailable { padding: 80px 18px; color: var(--muted); font-size: 12px; line-height: 1.6; }
