@import "../../common.wxss";

.video-result-page { min-height: 100vh; color: var(--text); background: var(--bg); }
.video-result-page__scroll { height: calc(100vh - 52px); box-sizing: border-box; padding: 0 16px calc(122px + env(safe-area-inset-bottom)); }
.result-content { padding-top: 4px; }
.result-intro { padding: 17px 3px 15px; }
.result-intro__meta { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.result-intro__eyebrow { color: var(--muted); font-size: 12px; font-weight: 700; }
.result-intro__platform { min-width: 0; overflow: hidden; color: var(--accent-text); font-size: 11px; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.result-intro__title { display: block; margin-top: 10px; color: var(--text); font-size: 19px; font-weight: 750; line-height: 1.45; overflow-wrap: anywhere; }
.result-intro__time { display: block; margin-top: 7px; color: var(--muted); font-size: 11px; }
.media-card { margin-bottom: 13px; background: var(--surface); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow-soft); overflow: hidden; }
.media-card__label { display: flex; align-items: center; justify-content: space-between; margin: 0; padding: 13px 14px 11px; color: var(--text); font-size: 13px; font-weight: 800; }
.media-card__hint { color: var(--faint); font-size: 10px; font-weight: 500; }
.video-stage { display: flex; align-items: center; justify-content: center; width: 100%; overflow: hidden; background: #101513; }
.result-video { display: block; flex: 0 0 auto; max-width: 100%; background: #101513; }
.media-card--video { padding: 0; }
.download-progress { margin: 0 3px 13px; }.download-progress__label { display: flex; justify-content: space-between; margin-bottom: 5px; color: var(--muted); font-size: 11px; }
.result-actions { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; display: flex; gap: 10px; padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); background: rgba(235, 240, 237, .97); border-top: 1px solid var(--border); }.result-actions button { flex: 1; height: 46px; margin: 0; border: 1px solid var(--border); border-radius: 14px; background: var(--surface); color: var(--accent-text); font-size: 13px; font-weight: 800; line-height: 46px; }.result-actions__primary { border-color: var(--accent) !important; background: var(--accent) !important; color: #fff !important; }.result-actions button[disabled] { opacity: .5; }
.result-footer { display: flex; justify-content: center; gap: 28px; padding: 18px 0 20px; color: var(--accent-text); font-size: 12px; font-weight: 700; }
.result-empty { margin-top: 80px; padding: 34px 18px; text-align: center; background: var(--surface); border: 1px solid var(--border); border-radius: 18px; }.result-empty__icon { display: block; color: var(--accent-text); font-size: 40px; }.result-empty__title { display: block; margin-top: 12px; color: var(--text); font-size: 16px; font-weight: 800; }.result-empty__note { display: block; margin-top: 7px; color: var(--muted); font-size: 12px; }.result-empty button { width: 100%; height: 44px; margin-top: 20px; border-radius: 14px; background: var(--accent); color: #fff; font-size: 13px; line-height: 44px; }
