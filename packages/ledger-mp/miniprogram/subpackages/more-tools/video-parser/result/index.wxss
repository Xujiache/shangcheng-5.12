@import "../../common.wxss";

.video-result-page { min-height: 100vh; color: var(--text); }
.video-result-page__scroll { height: calc(100vh - 52px); box-sizing: border-box; padding: 0 16px calc(122px + env(safe-area-inset-bottom)); }
.result-intro { padding: 20px 4px 17px; }
.result-intro__meta { display: flex; align-items: center; justify-content: space-between; }
.platform-badge { display: inline-flex; align-items: center; min-height: 25px; padding: 0 10px; border-radius: 999px; color: #fff; font-size: 11px; font-weight: 800; }
.platform-badge--douyin { background: #252525; }.platform-badge--kuaishou { background: #f09a28; }.platform-badge--bilibili { background: #f08bab; }.platform-badge--tiktok { background: #1d9f9b; }.platform-badge--other { background: var(--muted); }
.result-intro__status { color: var(--accent-text); font-size: 11px; font-weight: 700; }
.result-intro__title { display: block; margin-top: 12px; color: var(--text); font-size: 21px; font-weight: 800; line-height: 1.42; }
.result-intro__time { display: block; margin-top: 6px; color: var(--muted); font-size: 11px; }
.media-card { margin-bottom: 13px; padding: 13px; background: var(--surface); border: 1px solid var(--border); border-radius: 18px; box-shadow: var(--shadow-soft); }
.media-card__label { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; color: var(--text); font-size: 13px; font-weight: 800; }
.media-card__hint { color: var(--faint); font-size: 10px; font-weight: 500; }
.result-video { display: block; margin: 0 auto; border-radius: 13px; background: #101513; }
.media-card--video { padding-bottom: 13px; }
.download-progress { margin: 0 3px 13px; }.download-progress__label { display: flex; justify-content: space-between; margin-bottom: 5px; color: var(--muted); font-size: 11px; }
.result-actions { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; display: flex; gap: 10px; padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); background: rgba(245, 250, 247, .96); border-top: 1px solid var(--border); box-shadow: 0 -8px 28px rgba(22, 48, 37, .08); }.result-actions button { flex: 1; height: 46px; margin: 0; border: 1px solid var(--border); border-radius: 14px; background: var(--surface); color: var(--accent-text); font-size: 13px; font-weight: 800; line-height: 46px; }.result-actions__primary { border-color: var(--accent) !important; background: var(--accent) !important; color: #fff !important; }.result-actions button[disabled] { opacity: .5; }
.result-footer { display: flex; justify-content: center; gap: 28px; padding: 18px 0 20px; color: var(--accent-text); font-size: 12px; font-weight: 700; }
.result-empty { margin-top: 80px; padding: 34px 18px; text-align: center; background: var(--surface); border: 1px solid var(--border); border-radius: 18px; }.result-empty__icon { display: block; color: var(--accent-text); font-size: 40px; }.result-empty__title { display: block; margin-top: 12px; color: var(--text); font-size: 16px; font-weight: 800; }.result-empty__note { display: block; margin-top: 7px; color: var(--muted); font-size: 12px; }.result-empty button { width: 100%; height: 44px; margin-top: 20px; border-radius: 14px; background: var(--accent); color: #fff; font-size: 13px; line-height: 44px; }
