<lz-bg />
<view class="tool-page glass-page lz-route-scene {{_routeMotion}}">
  <lz-header title="玻璃 K 值计算" />
  <view wx:if="{{authorized}}" class="tool-body tool-body--with-actions glass-body">
    <view class="glass-topline"><text>玻璃中心传热系数</text><view class="glass-link" bindtap="openWeight">重量估算 <text>›</text></view></view>

    <view wx:if="{{result}}" class="tool-card glass-result">
      <view class="glass-section-head"><text>计算结果</text><text class="glass-tag">{{result.paneCount}} 片 · {{result.gapCount}} 腔</text></view>
      <view class="glass-result__number">{{result.value}}<text>W/(m²·K)</text></view>
      <view class="glass-result__construction">{{result.construction}} mm</view>
      <view class="glass-result__foot"><text>K / U 值越小，保温能力越好</text><text>中心值</text></view>
    </view>

    <view class="tool-card glass-config">
      <view class="glass-section-head"><text>玻璃构造</text><text class="glass-caption">室外 → 室内</text></view>
      <view class="glass-count-row">
        <view class="glass-presets">
          <view class="{{panes.length === 2 ? 'is-active' : ''}}" data-count="2" bindtap="presetCount">双玻</view>
          <view class="{{panes.length === 3 ? 'is-active' : ''}}" data-count="3" bindtap="presetCount">三玻</view>
          <view class="{{panes.length === 4 ? 'is-active' : ''}}" data-count="4" bindtap="presetCount">四玻</view>
        </view>
        <view class="glass-stepper">
          <button class="glass-stepper__button" disabled="{{panes.length <= 2}}" data-delta="-1" bindtap="changeCount">−</button>
          <picker range="{{counts}}" value="{{panes.length - 2}}" bindchange="chooseCount"><view>{{panes.length}} 片</view></picker>
          <button class="glass-stepper__button" disabled="{{panes.length >= 20}}" data-delta="1" bindtap="changeCount">＋</button>
        </view>
      </view>
      <view class="glass-stack-summary">{{construction}} <text>mm</text></view>
      <view class="glass-column-head"><text>构造层</text><text>厚度</text><text>表面 / 填充</text></view>
      <block wx:for="{{panes}}" wx:key="id" wx:for-item="pane" wx:for-index="paneIndex">
        <view class="glass-pane-block">
          <view class="glass-layer-row">
            <view class="glass-layer-label"><text class="glass-pane-mark"></text><text>{{paneIndex === 0 ? '外片' : paneIndex === panes.length - 1 ? '内片' : '中片'}} {{paneIndex + 1}}</text></view>
            <view class="glass-thickness"><input type="digit" maxlength="6" value="{{pane.thicknessMm}}" data-index="{{paneIndex}}" data-field="thicknessMm" bindinput="onPaneField" /><text>mm</text></view>
            <picker class="glass-layer-picker" range="{{pane.coatings}}" value="{{pane.coatingIndex}}" data-index="{{paneIndex}}" bindchange="chooseCoating"><view>{{pane.coatings[pane.coatingIndex]}}<text class="glass-chevron">⌄</text></view></picker>
          </view>
          <view wx:if="{{pane.coatingIndex > 0}}" class="glass-emissivities">
            <view wx:if="{{pane.coatingIndex === 1 || pane.coatingIndex === 3}}"><text>第 {{paneIndex * 2 + 1}} 面发射率</text><input type="digit" maxlength="5" value="{{pane.frontEmissivity}}" data-index="{{paneIndex}}" data-field="frontEmissivity" bindinput="onPaneField" /></view>
            <view wx:if="{{pane.coatingIndex === 2 || pane.coatingIndex === 3}}"><text>第 {{paneIndex * 2 + 2}} 面发射率</text><input type="digit" maxlength="5" value="{{pane.backEmissivity}}" data-index="{{paneIndex}}" data-field="backEmissivity" bindinput="onPaneField" /></view>
          </view>
        </view>
        <view wx:if="{{paneIndex < gaps.length}}" class="glass-gap-block">
          <view class="glass-layer-row">
            <picker class="glass-layer-label glass-gap-picker" range="{{gapTypes}}" range-key="label" value="{{gaps[paneIndex].typeIndex}}" data-index="{{paneIndex}}" bindchange="chooseGapType"><view><text class="glass-gap-mark"></text><text>{{gapTypes[gaps[paneIndex].typeIndex].label}} {{paneIndex + 1}}</text><text class="glass-chevron">⌄</text></view></picker>
            <view class="glass-thickness"><input type="digit" maxlength="6" value="{{gaps[paneIndex].thicknessMm}}" data-index="{{paneIndex}}" data-field="thicknessMm" bindinput="onGapField" /><text>mm</text></view>
            <picker wx:if="{{gaps[paneIndex].typeIndex === 0}}" class="glass-layer-picker" range="{{gases}}" range-key="label" value="{{gaps[paneIndex].gasIndex}}" data-index="{{paneIndex}}" bindchange="chooseGas"><view>{{gases[gaps[paneIndex].gasIndex].label}}<text class="glass-chevron">⌄</text></view></picker>
            <view wx:else class="glass-layer-picker glass-vacuum-toggle" data-index="{{paneIndex}}" bindtap="toggleGap">支撑柱参数 <text class="glass-chevron">{{gaps[paneIndex].expanded ? '⌃' : '⌄'}}</text></view>
          </view>
          <view wx:if="{{gaps[paneIndex].typeIndex === 1 && gaps[paneIndex].expanded}}" class="glass-vacuum-fields">
            <view class="glass-param"><text>真空压力</text><view><input type="digit" maxlength="8" value="{{gaps[paneIndex].vacuumPressurePa}}" data-index="{{paneIndex}}" data-field="vacuumPressurePa" bindinput="onGapField" /><text>Pa</text></view></view>
            <view class="glass-param"><text>柱直径</text><view><input type="digit" maxlength="6" value="{{gaps[paneIndex].pillarDiameterMm}}" data-index="{{paneIndex}}" data-field="pillarDiameterMm" bindinput="onGapField" /><text>mm</text></view></view>
            <view class="glass-param"><text>柱间距</text><view><input type="digit" maxlength="6" value="{{gaps[paneIndex].pillarPitchMm}}" data-index="{{paneIndex}}" data-field="pillarPitchMm" bindinput="onGapField" /><text>mm</text></view></view>
          </view>
        </view>
      </block>
      <view class="glass-config-foot">A 空气 · Ar 氩气 · V 真空<text>{{panes.length}} 片 / {{gaps.length}} 腔</text></view>
    </view>

    <view class="tool-card glass-boundary">
      <view class="glass-section-head glass-boundary-toggle" bindtap="toggleAdvanced"><text>计算条件</text><text class="glass-caption">室外 0℃ · 室内 20℃ <text class="glass-chevron">{{advanced ? '⌃' : '⌄'}}</text></text></view>
      <view wx:if="{{advanced}}" class="glass-boundary-fields">
        <view class="glass-param"><text>室外表面系数</text><view><input type="digit" maxlength="6" value="{{outsideH}}" data-field="outsideH" bindinput="onBoundary" /><text>W/(m²·K)</text></view></view>
        <view class="glass-param"><text>室内表面系数</text><view><input type="digit" maxlength="6" value="{{insideH}}" data-field="insideH" bindinput="onBoundary" /><text>W/(m²·K)</text></view></view>
        <view class="glass-caption glass-boundary-note">竖直玻璃 · 无太阳辐照 · 玻璃导热系数 1 W/(m·K)</view>
      </view>
    </view>
    <view class="glass-explanation"><text>计算说明</text><view>按玻璃中心区域估算，不含窗框、间隔条和边缘热桥。Low-E 发射率、气体及真空参数应按实际产品填写。</view><view>结果用于方案比较，检测值以厂家报告为准。</view></view>
    <view wx:if="{{error}}" class="glass-error" role="alert">{{error}}</view>
    <view class="tool-actions glass-actions"><button class="tool-secondary" bindtap="reset">重置</button><button class="tool-primary" loading="{{calculating}}" disabled="{{calculating}}" bindtap="calculate">计算 K 值</button></view>
  </view>
  <view wx:else class="tool-locked"><text>登录后可免费使用玻璃 K 值计算</text><button class="tool-primary" bindtap="login">去登录</button></view>
</view>
<lz-route-feedback busy="{{_routeBusy}}" slow="{{_routeSlow}}" top="{{_routeTop}}" />
