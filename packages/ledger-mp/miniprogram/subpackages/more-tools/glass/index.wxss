@import "../common.wxss";
.glass-body { padding-top: 10px; }
.glass-topline { display: flex; justify-content: space-between; align-items: center; margin: 0 2px 12px; color: var(--muted); font-size: 12px; }
.glass-link { color: var(--accent-text); font-size: 12px; }
.glass-link > text { margin-left: 3px; font-size: 18px; }
.glass-page .tool-card { padding: 14px; margin-bottom: 12px; box-shadow: none; }
.glass-section-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; color: var(--text); font-size: 15px; font-weight: 700; }
.glass-caption { color: var(--muted); font-size: 11px; font-weight: 400; }
.glass-count-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin: 12px 0 10px; }
.glass-presets { display: flex; align-items: center; gap: 4px; }
.glass-presets > view { padding: 7px 9px; border: 1px solid var(--border); border-radius: 9px; color: var(--muted); font-size: 12px; }
.glass-presets .is-active { color: var(--accent-text); border-color: var(--accent); background: rgba(14,124,102,.07); font-weight: 700; }
.glass-stepper { display: flex; align-items: center; border: 1px solid var(--border); border-radius: 9px; overflow: hidden; }
.glass-stepper .glass-stepper__button { width: 30px; min-height: 32px; margin: 0; padding: 0; border-radius: 0; color: var(--accent-text); background: transparent; font-size: 17px; line-height: 1; }
.glass-stepper__button[disabled] { opacity: .3; }
.glass-stepper picker > view { min-width: 48px; padding: 0 6px; color: var(--text); font-size: 12px; text-align: center; }
.glass-stack-summary { padding: 9px 10px; margin-bottom: 12px; border-radius: 9px; background: rgba(14,124,102,.06); color: var(--accent-text); font-size: 13px; line-height: 1.6; font-weight: 600; overflow-wrap: break-word; }
.glass-stack-summary > text { margin-left: 4px; color: var(--muted); font-size: 10px; font-weight: 400; }
.glass-column-head, .glass-layer-row { display: flex; align-items: center; gap: 8px; }
.glass-column-head { padding: 0 0 7px; color: var(--faint); font-size: 10px; border-bottom: 1px solid var(--border); }
.glass-column-head text:first-child { width: 88px; }
.glass-column-head text:nth-child(2) { width: 60px; text-align: center; }
.glass-column-head text:last-child { flex: 1; text-align: right; }
.glass-layer-row { min-height: 49px; }
.glass-layer-label { width: 88px; flex-shrink: 0; display: flex; align-items: center; gap: 6px; color: var(--text); font-size: 12px; font-weight: 600; }
.glass-pane-mark { width: 7px; height: 22px; flex-shrink: 0; border: 1px solid #88bdb2; border-radius: 2px; background: #d8ede6; }
.glass-gap-mark { width: 7px; height: 19px; flex-shrink: 0; border: 1px dashed #a8b9b2; border-radius: 2px; }
.glass-thickness { width: 60px; height: 31px; flex-shrink: 0; display: flex; align-items: center; gap: 2px; padding: 0 5px; background: rgba(79,115,100,.05); border: 1px solid var(--border); border-radius: 7px; }
.glass-thickness input { flex: 1; width: 0; min-width: 0; height: 100%; color: var(--text); font-size: 14px; font-weight: 600; text-align: center; }
.glass-thickness > text { color: var(--muted); font-size: 9px; }
.glass-layer-picker { flex: 1; min-width: 0; color: var(--muted); font-size: 11px; }
.glass-layer-picker > view { display: flex; align-items: center; justify-content: flex-end; gap: 4px; min-height: 36px; }
.glass-chevron { color: var(--faint); font-size: 12px; margin-left: 3px; }
.glass-gap-block { margin: 0 -8px; padding: 0 8px; border-radius: 8px; background: rgba(91,120,108,.045); }
.glass-gap-picker > view { display: flex; align-items: center; gap: 3px; min-height: 40px; color: var(--muted); font-size: 11px; font-weight: 400; }
.glass-gap-picker .glass-gap-mark { margin-right: 3px; }
.glass-vacuum-toggle { text-align: right; }
.glass-emissivities { display: flex; flex-wrap: wrap; gap: 8px; padding: 0 0 9px 13px; }
.glass-emissivities > view { flex: 1; display: flex; align-items: center; gap: 6px; color: var(--muted); font-size: 10px; }
.glass-emissivities input { width: 47px; height: 29px; border-bottom: 1px solid var(--border); color: var(--text); font-size: 12px; text-align: center; }
.glass-vacuum-fields { display: flex; gap: 8px; padding: 0 0 10px 13px; }
.glass-vacuum-fields .glass-param { flex: 1; min-width: 0; }
.glass-param > text { color: var(--muted); font-size: 10px; }
.glass-param > view { display: flex; align-items: center; gap: 4px; margin-top: 5px; padding: 0 6px; height: 32px; border: 1px solid var(--border); border-radius: 7px; background: var(--surface); }
.glass-param input { flex: 1; min-width: 0; width: 0; height: 100%; color: var(--text); font-size: 13px; }
.glass-param > view > text { color: var(--faint); font-size: 9px; }
.glass-config-foot { display: flex; justify-content: space-between; margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--border); color: var(--faint); font-size: 10px; }
.glass-page .glass-boundary { padding-top: 0; padding-bottom: 0; }
.glass-boundary-toggle { min-height: 46px; font-size: 13px; }
.glass-boundary-fields { display: flex; flex-wrap: wrap; gap: 10px; padding: 0 0 13px; border-top: 1px solid var(--border); }
.glass-boundary-fields .glass-param { flex: 1; padding-top: 10px; }
.glass-boundary-note { width: 100%; line-height: 1.6; }
.glass-explanation { margin: 3px 3px 12px; color: var(--muted); font-size: 11px; line-height: 1.7; }
.glass-explanation > text { display: block; margin-bottom: 3px; color: var(--text); font-weight: 600; }
.glass-tag { padding: 4px 7px; border-radius: 6px; color: var(--accent-text); background: rgba(14,124,102,.07); font-size: 10px; font-weight: 500; }
.glass-result__number { margin: 7px 0 5px; color: var(--accent-text); font-size: 36px; line-height: 1.3; font-weight: 700; font-variant-numeric: tabular-nums; }
.glass-result__number > text { margin-left: 7px; color: var(--muted); font-size: 12px; font-weight: 400; }
.glass-result__construction { color: var(--text); font-size: 12px; line-height: 1.6; overflow-wrap: break-word; }
.glass-result__foot { display: flex; justify-content: space-between; gap: 8px; margin-top: 9px; padding-top: 9px; border-top: 1px solid var(--border); color: var(--muted); font-size: 10px; }
.glass-error { margin: 0 2px 12px; color: #b44735; font-size: 12px; line-height: 1.6; }
.glass-actions .tool-secondary { flex: 0 0 84px; }
.glass-actions button { height: 46px; padding: 0 12px; border-radius: 16px; }
