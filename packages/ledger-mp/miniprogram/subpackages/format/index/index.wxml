<view class="format lz-route-scene {{_routeMotion}}">
  <view class="format__tabs">
    <view class="format__tab {{activeTab === 'convert' ? 'format__tab--active' : ''}}" data-tab="convert" bindtap="switchTab">文件转换</view>
    <view class="format__tab {{activeTab === 'history' ? 'format__tab--active' : ''}}" data-tab="history" bindtap="switchTab">转换记录<text wx:if="{{jobs.length}}" class="format__tab-count">{{jobs.length}}</text></view>
  </view>

  <view wx:if="{{activeTab === 'convert'}}" class="format__content {{files.length ? 'format__content--with-dock' : ''}}">
    <view wx:if="{{loading}}" class="format__state"><view class="format__spinner"></view><view>正在连接转换服务…</view></view>
    <view wx:elif="{{!capabilities || !capabilities.available}}" class="format__state">
      <view class="format__state-title">{{capabilities ? '格式转换暂未开放' : '暂时无法连接'}}</view>
      <view class="format__muted">{{capabilities ? '服务正在准备中，请稍后重试' : (error || '请检查网络连接')}}</view>
      <button size="mini" class="format__button format__button--outline" bindtap="refresh">重新连接</button>
    </view>
    <block wx:else>
      <view class="format__workspace">
        <view wx:if="{{!files.length}}" class="format__upload">
          <view class="format__document-icon"><view class="format__document-line"></view><view class="format__document-line format__document-line--short"></view><view class="format__document-plus">＋</view></view>
          <view class="format__upload-title">选择要转换的文件</view>
          <view class="format__upload-desc">文档、图片、音频和视频</view>
          <button size="mini" class="format__button format__button--primary format__select-file" bindtap="openSourcePicker">选择文件</button>
          <view class="format__limit">{{limitHint}}</view>
        </view>
        <block wx:else>
          <view class="format__queue-head"><text class="format__label">已选文件 · {{files.length}}</text><view class="format__queue-actions"><text wx:if="{{files.length > 1}}" class="format__text-action" bindtap="toggleSort">{{sortMode ? '完成排序' : '排序'}}</text><text class="format__text-action" bindtap="openSourcePicker">＋ 添加</text></view></view>
          <view wx:for="{{files}}" wx:for-item="file" wx:for-index="index" wx:key="path" class="format__file">
            <format-file-visual kind="{{file.visualKind}}" extension="{{file.extensionLabel}}" thumbnail-path="{{file.thumbnailPath}}" media-path="{{file.mediaPath}}" />
            <view class="format__file-info"><view class="format__filename">{{file.name}}</view><view class="format__file-meta">{{file.sizeLabel}}</view></view>
            <view wx:if="{{sortMode}}" class="format__file-order"><button size="mini" wx:if="{{index > 0}}" class="format__icon-button" data-index="{{index}}" data-direction="-1" bindtap="moveFile" disabled="{{busy}}">↑</button><button size="mini" wx:if="{{index < files.length - 1}}" class="format__icon-button" data-index="{{index}}" data-direction="1" bindtap="moveFile" disabled="{{busy}}">↓</button></view>
            <button size="mini" wx:else class="format__icon-button" data-index="{{index}}" bindtap="removeFile" disabled="{{busy}}" aria-label="移除文件">×</button>
          </view>
          <view wx:if="{{!operations.length}}" class="format__inline-error">这些文件无法转成同一种格式，请分开转换。</view>
          <block wx:else>
            <view class="format__target" bindtap="openFormatPicker"><text class="format__label">转换为</text><view class="format__target-value {{!operation ? 'format__target-value--empty' : ''}}">{{operation ? operation.displayLabel : '选择目标格式'}}<text class="format__chevron">⌄</text></view></view>
            <view wx:if="{{operation && (showTextEncoding || showVideoOptions || showPdfOptions)}}" class="format__settings-toggle" bindtap="toggleSettings"><text>转换设置</text><text class="format__muted">{{settingsOpen ? '收起 −' : '展开 ＋'}}</text></view>
            <view wx:if="{{settingsOpen}}" class="format__settings">
            <picker wx:if="{{visibleOptionKeys.textEncoding}}" class="format__setting" disabled="{{busy}}" mode="selector" range="{{encodingOptions}}" value="{{optionIndexes.textEncoding}}" data-key="textEncoding" bindchange="onOptionSelect"><view class="format__setting-row"><text>源文件编码</text><text class="format__setting-value">{{encodingOptions[optionIndexes.textEncoding]}} ›</text></view></picker>
            <picker wx:if="{{visibleOptionKeys.videoCodec}}" class="format__setting" disabled="{{busy}}" mode="selector" range="{{codecOptions}}" value="{{optionIndexes.videoCodec}}" data-key="videoCodec" bindchange="onOptionSelect"><view class="format__setting-row"><text>视频编码</text><text class="format__setting-value">{{codecOptions[optionIndexes.videoCodec]}} ›</text></view></picker>
            <picker wx:if="{{visibleOptionKeys.alphaBackground}}" class="format__setting" disabled="{{busy}}" mode="selector" range="{{backgroundOptions}}" value="{{optionIndexes.alphaBackground}}" data-key="alphaBackground" bindchange="onOptionSelect"><view class="format__setting-row"><text>透明背景</text><text class="format__setting-value">{{backgroundOptions[optionIndexes.alphaBackground]}} ›</text></view></picker>
            <picker wx:if="{{visibleOptionKeys.pdfAction}}" class="format__setting" disabled="{{busy}}" mode="selector" range="{{pdfActionOptions}}" value="{{optionIndexes.pdfAction}}" data-key="pdfAction" bindchange="onOptionSelect"><view class="format__setting-row"><text>PDF 操作</text><text class="format__setting-value">{{pdfActionOptions[optionIndexes.pdfAction]}} ›</text></view></picker>
            <view wx:if="{{showPdfOptions && localTest && capabilities.features && !capabilities.features.pdfEncryption}}" class="format__setting-hint">加密和解密功能暂不可用。</view>
            <picker wx:if="{{visibleOptionKeys.splitMode && !optionValues.pdfAction}}" class="format__setting" disabled="{{busy}}" mode="selector" range="{{splitModeOptions}}" value="{{optionIndexes.splitMode}}" data-key="splitMode" bindchange="onOptionSelect"><view class="format__setting-row"><text>拆分方式</text><text class="format__setting-value">{{splitModeOptions[optionIndexes.splitMode]}} ›</text></view></picker>
            <view wx:if="{{visibleOptionKeys.groupSize && optionValues.splitMode === 'group' && !optionValues.pdfAction}}" class="format__setting format__setting-row"><text>每组页数</text><input disabled="{{busy}}" class="format__setting-input" type="number" data-key="groupSize" value="{{optionValues.groupSize}}" bindinput="onOptionInput" placeholder="输入页数" /></view>
            <view wx:if="{{visibleOptionKeys.password && optionValues.pdfAction}}" class="format__setting format__setting-row"><text>PDF 密码</text><input disabled="{{busy}}" class="format__setting-input" password data-key="password" value="{{optionValues.password}}" bindinput="onOptionInput" placeholder="输入密码" /></view>
            </view>
          </block>
          <view wx:if="{{busy}}" class="format__upload-progress"><view class="format__progress"><view class="format__progress-fill" style="width: {{uploadPercent}}%"></view></view><view class="format__muted">{{busyText}} · {{uploadPercent}}%</view></view>
        </block>
      </view>
      <view wx:if="{{error}}" class="format__inline-error">{{error}}</view>
      <view wx:if="{{localTest}}" class="format__service-note"><view class="format__service-dot"></view>文件由电脑上的本地服务处理</view>
      <view wx:if="{{!files.length && jobs.length}}" class="format__recent" data-tab="history" bindtap="switchTab"><text>查看最近的转换记录</text><text>›</text></view>
    </block>
  </view>

  <view wx:else class="format__content">
    <view wx:if="{{!jobs.length}}" class="format__state format__history-empty"><view class="format__empty-records">≡</view><view class="format__state-title">暂无转换记录</view><view class="format__muted">转换后的文件会保存在这里</view><button size="mini" class="format__button format__button--outline" data-tab="convert" bindtap="switchTab">去转换</button></view>
    <view wx:for="{{jobs}}" wx:for-item="job" wx:key="id" class="format__job">
      <view class="format__job-head"><view class="format__job-title">{{job.operationLabel}}</view><text class="format__status format__status--{{job.status}}">{{job.statusLabel}}</text><button size="mini" class="format__icon-button format__job-menu" data-id="{{job.id}}" bindtap="jobMenu" aria-label="任务操作">···</button></view>
      <view wx:if="{{!job.assets.length}}" class="format__job-source">{{job.sourceLabel}}</view>
      <view class="format__job-date">{{job.createdLabel}}</view>
      <view wx:if="{{job.status === 'queued' || job.status === 'running'}}" class="format__progress"><view class="format__progress-fill" style="width: {{job.progress}}%"></view></view>
      <view wx:if="{{job.error}}" class="format__inline-error">{{job.error}}</view>
      <view wx:if="{{job.warnings && job.warnings.length}}" class="format__job-warnings"><view class="format__job-warnings-title">转换提示 · 请核对结果</view><view wx:for="{{job.warnings}}" wx:for-item="warning" wx:key="*this">{{warning}}</view></view>
      <view wx:for="{{job.assets}}" wx:for-item="asset" wx:key="id" class="format__result">
        <view class="format__result-file"><format-file-visual kind="{{asset.visualKind}}" extension="{{asset.extensionLabel}}" thumbnail-path="{{asset.thumbnailPath}}" media-path="{{asset.mediaPath}}" /><view class="format__file-info"><view class="format__filename">{{asset.fileName}}</view><view class="format__file-meta">{{asset.sizeLabel}}</view></view></view>
        <view class="format__result-actions"><button wx:if="{{asset.canPreview}}" size="mini" class="format__button format__button--plain" data-job="{{job.id}}" data-asset="{{asset.id}}" bindtap="openAsset">预览</button><button size="mini" class="format__button format__button--outline" data-job="{{job.id}}" data-asset="{{asset.id}}" bindtap="exportAsset">导出文件</button></view>
      </view>
    </view>
    <button size="mini" wx:if="{{hasMore}}" class="format__button format__button--plain format__more" bindtap="loadMore">加载更多</button>
  </view>

  <view wx:if="{{activeTab === 'convert' && files.length}}" class="format__dock">
    <view class="format__dock-summary"><text>{{files.length}} 个文件 · {{totalSizeLabel}}</text><text wx:if="{{operation}}" class="format__dock-target">→ {{operation.displayLabel}}</text></view>
    <button size="mini" class="format__button format__button--primary format__submit {{busy || !operations.length ? 'format__button--disabled' : ''}}" bindtap="start" disabled="{{busy || !operations.length}}" loading="{{busy}}">{{busy ? '正在上传…' : operation ? '开始转换' : '选择目标格式'}}</button>
  </view>
</view>

<lz-route-feedback busy="{{_routeBusy}}" slow="{{_routeSlow}}" top="{{_routeTop}}" />

<view wx:if="{{sourceOpen}}" class="format__backdrop" bindtap="closeSourcePicker" catchtouchmove="noop">
  <view class="format__sheet" catchtap="noop"><view class="format__sheet-head"><text class="format__sheet-title">添加文件</text><button size="mini" class="format__icon-button" bindtap="closeSourcePicker" aria-label="关闭">×</button></view>
    <view class="format__source-option" bindtap="chooseMessage"><view class="format__source-icon"><lz-icon name="wechat" size="26" color="accent" /></view><view class="format__source-copy"><view class="format__source-title">从微信聊天选择</view><view class="format__muted">选择聊天中的文档、图片或其他文件</view></view><text class="format__source-arrow">›</text></view>
    <view class="format__source-option" bindtap="chooseMedia"><view class="format__source-icon"><lz-icon name="image" size="26" color="accent" /></view><view class="format__source-copy"><view class="format__source-title">从相册选择</view><view class="format__muted">选择照片、视频，或拍摄新内容</view></view><text class="format__source-arrow">›</text></view>
  </view>
</view>

<view wx:if="{{formatOpen}}" class="format__backdrop" bindtap="closeFormatPicker" catchtouchmove="noop">
  <view class="format__sheet format__sheet--formats" catchtap="noop"><view class="format__sheet-head"><text class="format__sheet-title">转换为</text><button size="mini" class="format__icon-button" bindtap="closeFormatPicker" aria-label="关闭">×</button></view>
    <input class="format__search" value="{{formatQuery}}" bindinput="onFormatQuery" placeholder="搜索格式，如 PDF、JPG" confirm-type="search" />
    <scroll-view class="format__categories" scroll-x><view class="format__categories-inner"><view wx:for="{{visibleFormatCategories}}" wx:key="*this" class="format__category {{formatCategory === item ? 'format__category--active' : ''}}" data-category="{{item}}" bindtap="chooseCategory">{{item}}</view></view></scroll-view>
    <scroll-view class="format__format-list" scroll-y><view class="format__format-grid"><view wx:for="{{filteredOperations}}" wx:key="id" class="format__format-option {{operation && operation.id === item.id ? 'format__format-option--active' : ''}}" data-id="{{item.id}}" bindtap="chooseOperation">{{item.displayLabel}}</view></view><view wx:if="{{!filteredOperations.length}}" class="format__no-matches">没有匹配的格式</view></scroll-view>
  </view>
</view>

<view wx:if="{{previewText || previewVideo || previewAudio}}" class="format__backdrop format__preview-backdrop" bindtap="closePreview">
  <view class="format__preview" catchtap="noop"><view class="format__sheet-head"><text class="format__sheet-title">文件预览</text><button size="mini" class="format__icon-button" bindtap="closePreview" aria-label="关闭">×</button></view><scroll-view wx:if="{{previewText}}" scroll-y class="format__preview-scroll"><text selectable>{{previewText}}</text></scroll-view><video wx:if="{{previewVideo}}" class="format__preview-media" src="{{previewVideo}}" controls /><audio wx:if="{{previewAudio}}" class="format__preview-media" src="{{previewAudio}}" controls /></view>
</view>
