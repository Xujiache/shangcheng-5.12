@import './styles/tokens.wxss';
@import './styles/animations.wxss';
@import './styles/components.wxss';

/* 全局基础 */
page {
  background: var(--bg); /* 兜底色；流动背景由各页 <lz-bg /> 提供 */
  height: 100%;
}
view, text, button, input, textarea, scroll-view {
  box-sizing: border-box;
}
button::after {
  border: none;
}

/* 点按反馈（配合 hover-class="tap-active"） */
.tap-active {
  transform: scale(0.975);
  opacity: 0.92;
}

/* 隐藏滚动条 */
.scroll-body {
  -webkit-overflow-scrolling: touch;
}
::-webkit-scrollbar {
  width: 0;
  height: 0;
  background: transparent;
}

/* 通用动画类 */
.screen-fwd { animation: slideInR 0.3s cubic-bezier(0.22, 1, 0.36, 1); }
.fade-in { animation: fadeIn 0.22s ease; }

/* 四个底部 Tab 页统一进入节奏；通过 A/B class 切换让缓存页每次 onShow 都能重播。 */
.tab-page--motion-a,
.tab-page--motion-b {
  backface-visibility: hidden;
  animation: tabPageIn 0.26s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@media (prefers-reduced-motion: reduce) {
  .tab-page--motion-a,
  .tab-page--motion-b {
    animation: none;
  }
}
