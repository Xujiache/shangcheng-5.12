.wb{min-height:100vh;background:#f1f5f2;color:#203a30;padding-bottom:calc(105px + env(safe-area-inset-bottom));box-sizing:border-box}.wb-body{padding:16px 18px}.wb-card{background:#fff;border-radius:18px;padding:18px;margin-bottom:14px;border:1px solid #e8eee9;box-shadow:0 4px 18px rgba(31,74,52,.025)}.wb-hero{background:linear-gradient(125deg,#0e7c66,#299d7f);color:#fff;border:0}.wb-hero .wb-muted{color:#d6eee4}.wb-title{font-size:19px;font-weight:750;letter-spacing:-.3px}.wb-label{font-size:13px;font-weight:600}.wb-muted{font-size:12px;color:#73847a;line-height:1.6}.wb-money{font-size:32px;font-weight:750;letter-spacing:-1px;margin:8px 0;font-variant-numeric:tabular-nums;word-break:break-all}.wb-row{display:flex;align-items:center;justify-content:space-between;gap:12px}.wb-row+.wb-row{margin-top:12px}.wb-flex{flex:1;min-width:0}.wb-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.wb-grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.wb-stat{padding:12px;background:#f4f8f5;border-radius:12px;min-width:0}.wb-stat-v{font-size:17px;font-weight:700;margin-top:6px;word-break:break-all}.wb-btn{background:#0e7c66;color:#fff;border-radius:12px;padding:0 16px;font-size:15px;line-height:44px;margin:0;border:0}.wb-btn::after{border:0}.wb-btn[disabled]{opacity:.45;color:#fff;background:#0e7c66}.wb-btn--soft{background:#eaf4ee;color:#0e7c66}.wb-btn--danger{background:#fff0eb;color:#b84d38}.wb-btn--small{font-size:12px;line-height:34px;padding:0 10px}.wb-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.wb-actions .wb-btn{flex:1;min-width:70px}.wb-field{margin-top:16px}.wb-field>text{display:block;font-size:12px;color:#65796d;margin-bottom:7px}.wb-field input,.wb-field textarea,.wb-select{background:#f4f7f4;border:1px solid #e5ede7;border-radius:10px;min-height:44px;box-sizing:border-box;padding:10px 12px;font-size:14px;color:#263e32;width:100%}.wb-field textarea{height:86px}.wb-field input{height:44px}.wb-select{line-height:23px}.wb-section{font-size:15px;font-weight:700;margin:20px 0 12px}.wb-list-row{padding:14px 0;border-bottom:1px solid #edf1ee}.wb-list-row:last-child{border-bottom:0}.wb-list-title{font-size:14px;font-weight:650;overflow-wrap:anywhere}.wb-tag{display:inline-block;background:#eaf4ee;border-radius:5px;padding:3px 6px;font-size:10px;color:#18765b;flex-shrink:0}.wb-tag--warm{background:#fff2dd;color:#a06e21}.wb-empty{text-align:center;padding:36px 16px;color:#728379;font-size:13px;line-height:1.9}.wb-chips{display:flex;flex-wrap:wrap;gap:7px;margin:12px 0}.wb-chip{font-size:12px;line-height:32px;padding:0 12px;border-radius:9px;background:#fff;border:1px solid #e0e9e3;color:#63786b}.wb-chip.active{background:#0e7c66;color:#fff;border-color:#0e7c66}.wb-fixed{position:fixed;bottom:calc(72px + env(safe-area-inset-bottom));right:18px;left:18px;z-index:15;box-shadow:0 6px 20px rgba(14,124,102,.2);border-radius:12px}.wb-check{display:flex;align-items:center;gap:8px;font-size:13px;padding:10px 0}.wb-check checkbox{transform:scale(.85)}.wb-proof{width:64px;height:64px;border-radius:10px;background:#ecf2ee}.wb-warn{background:#fff6e3;border-radius:10px;padding:10px 12px;font-size:12px;line-height:1.6;color:#926925;margin-bottom:12px}.wb-calendar{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px}.wb-day{text-align:center;padding:10px 0;border-radius:9px;font-size:13px;min-height:37px}.wb-day.has{background:#eaf4ee;color:#0e7c66}.wb-day.selected{background:#0e7c66;color:white}.wb-day small{display:block;font-size:9px}.wb-bar{height:7px;background:#e8f2ec;border-radius:7px;margin-top:8px;overflow:hidden}.wb-bar>view{height:7px;background:#3aa98a;border-radius:7px}.wb-sep{height:1px;background:#e9efe9;margin:16px 0}.wb-danger{color:#b14d39}.wb-link{color:#0e7c66;font-size:13px}.wb-error{padding:14px;border-radius:12px;background:#fff0eb;color:#a74c38;white-space:pre-wrap;font-size:12px}.wb-date-label{margin:12px 0 4px;font-size:12px;color:#6c8173}

/* Artwork is generated; these rules only lay out controls and animate the generated spinner. */
.wb-generated-checkbox{position:relative;flex-shrink:0;width:22px;height:22px;display:inline-flex;vertical-align:middle;}
.wb .wb-generated-checkbox checkbox{position:absolute;inset:0;width:22px;height:22px;opacity:0;transform:none;z-index:1;}
.wb-generated-checkbox-visual{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;border:1px solid #c8ddd1;border-radius:6px;background:#f6faf7;pointer-events:none;}
.wb-generated-loading{display:inline-flex;vertical-align:middle;margin-right:6px;animation:wb-icon-spin 1.2s linear infinite;}
@keyframes wb-icon-spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
.wb-select{display:flex;align-items:center;justify-content:space-between;gap:7px;}
.wb-inline-action{display:inline-flex;align-items:center;gap:6px;}
