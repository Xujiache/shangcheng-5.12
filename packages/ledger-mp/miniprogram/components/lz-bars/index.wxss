.bars {
  width: 100%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}
.bars__plot {
  width: 100%;
  min-width: 0;
  display: flex;
  align-items: flex-end;
}
.bars__col {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: opacity 0.2s;
}
.bars__stack {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 3px;
  width: 100%;
}
.bars__bar {
  position: relative;
  width: 62%;
  max-width: 22px;
  border-radius: var(--r-bar) var(--r-bar) 2px 2px;
  transition: height 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}
/* 条顶数字标签 */
.bars__val {
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%);
  margin-bottom: 2px;
  font-size: 9px;
  font-weight: 600;
  color: var(--muted);
  white-space: nowrap;
}
.bars__bar--2 {
  width: 38%;
  max-width: 16px;
}
.bars__axis {
  position: relative;
  width: 100%;
  height: 16px;
  flex: none;
  margin-top: 7px;
}
.bars__axis-label {
  position: absolute;
  top: 0;
  display: block;
  width: 28px;
  height: 16px;
  box-sizing: border-box;
  font-size: 11px;
  font-weight: 500;
  line-height: 16px;
  text-align: center;
  white-space: nowrap;
  color: var(--faint);
  transform: translateX(-50%);
}
.bars__axis-label--start {
  text-align: left;
  transform: none;
}
.bars__axis-label--end {
  text-align: right;
  transform: translateX(-100%);
}
.bars__axis-label.on {
  font-weight: 600;
  color: var(--text);
}
