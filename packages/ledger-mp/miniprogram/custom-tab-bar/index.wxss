/* 自定义 TabBar 在独立上下文渲染，颜色取自 styles/tokens.wxss 的固定值。 */
.ctb {
  position: fixed;
  right: 12px;
  bottom: calc(14px + env(safe-area-inset-bottom));
  left: 12px;
  z-index: 100;
}
.ctb__bar {
  position: relative;
  height: 66px;
  padding: 0 6px;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 30px;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.55) 0%, rgba(255, 255, 255, 0.32) 100%);
  -webkit-backdrop-filter: blur(20px) saturate(175%);
  backdrop-filter: blur(20px) saturate(175%);
  box-shadow:
    0 16px 48px rgba(8, 24, 18, 0.26),
    0 2px 8px rgba(8, 24, 18, 0.1),
    0 0 26px -6px rgba(46, 180, 150, 0.35),
    inset 0 1.5px 1px rgba(255, 255, 255, 0.96),
    inset 0 -2px 8px rgba(255, 255, 255, 0.45);
}
.ctb__bar--solid {
  border-color: rgba(20, 32, 28, 0.08);
  background: #fff;
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
}
.ctb__tab {
  position: relative;
  z-index: 1;
  height: 54px;
  min-width: 0;
  padding: 2px 0;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  box-sizing: border-box;
  border-radius: 24px;
  transition:
    transform 0.16s ease,
    opacity 0.16s ease;
}
.ctb__glass {
  position: absolute;
  z-index: 0;
  top: 1px;
  right: 5px;
  bottom: 1px;
  left: 5px;
  border: 1px solid rgba(255, 255, 255, 0.74);
  border-radius: 22px;
  opacity: 0;
  transform: scale(0.94);
  background: rgba(255, 255, 255, 0.26);
  -webkit-backdrop-filter: blur(8px) saturate(165%) brightness(1.04);
  backdrop-filter: blur(8px) saturate(165%) brightness(1.04);
  box-shadow:
    0 5px 14px -5px rgba(8, 24, 18, 0.28),
    inset 0 2px 8px rgba(255, 255, 255, 0.5),
    inset 0 -2px 6px rgba(46, 180, 150, 0.08);
  pointer-events: none;
  transition:
    opacity 0.18s ease,
    transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
}
.ctb__glass--on {
  opacity: 1;
  transform: scale(1);
}
.ctb__ic {
  position: relative;
  z-index: 1;
  width: 26px;
  height: 26px;
}
.ctb__icon-image {
  display: block;
  width: 26px;
  height: 26px;
  opacity: 0.7;
  transition: opacity 0.2s ease;
}
.ctb__icon-image--on {
  opacity: 1;
}
.ctb__t {
  position: relative;
  z-index: 1;
  color: #5c6b64;
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0;
  transition: color 0.2s ease;
}
.ctb__t--on {
  color: #0e7c66;
  font-weight: 700;
}
.ctb__fab {
  position: relative;
  z-index: 2;
  width: 56px;
  height: 56px;
  margin: 0 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  overflow: hidden;
  box-sizing: border-box;
  border: 3px solid #fff;
  border-radius: 50%;
  transform: translateY(-14px);
  background: linear-gradient(150deg, #3ba58c, #0e7c66);
  box-shadow:
    0 8px 20px rgba(14, 124, 102, 0.42),
    inset 0 2px 3px rgba(255, 255, 255, 0.45),
    inset 0 -3px 6px rgba(0, 56, 42, 0.28);
}
.ctb__fab::after {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  opacity: 0;
  transform: translate(-50%, -50%) scale(0);
  background: radial-gradient(circle, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0));
  content: '';
  pointer-events: none;
}
.ctb__fab:active::after {
  animation: ctbBurst 0.55s ease-out;
}
@keyframes ctbBurst {
  0% {
    opacity: 0.75;
    transform: translate(-50%, -50%) scale(0);
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(20);
  }
}

@media (prefers-reduced-motion: reduce) {
  .ctb__tab,
  .ctb__glass,
  .ctb__icon-image,
  .ctb__t {
    transition: none;
  }
  .ctb__fab:active::after {
    animation: none;
  }
}
