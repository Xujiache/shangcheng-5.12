/* Never transform a whole page: fixed footers, keyboards, sheets and canvas coordinates stay native. */
.lz-route-reveal-a {
  animation: lzRouteRevealA 220ms cubic-bezier(0.22, 1, 0.36, 1) backwards;
}
.lz-route-reveal-b {
  animation: lzRouteRevealB 220ms cubic-bezier(0.22, 1, 0.36, 1) backwards;
}
@keyframes lzRouteRevealA {
  from {
    opacity: 0.86;
  }
  to {
    opacity: 1;
  }
}
@keyframes lzRouteRevealB {
  from {
    opacity: 0.86;
  }
  to {
    opacity: 1;
  }
}
.lz-route-scene [hover-class] {
  -webkit-tap-highlight-color: transparent;
}
.tap-active {
  transition:
    transform 100ms ease-out,
    opacity 100ms ease-out;
}
@media (prefers-reduced-motion: reduce) {
  .lz-route-reveal-a,
  .lz-route-reveal-b {
    animation: none;
  }
  .lz-route-scene .tap-active {
    transform: none;
    transition: none;
  }
}
