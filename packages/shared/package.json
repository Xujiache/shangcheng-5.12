{
  "name": "@jiujiu/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "经纬科技共享层：design tokens、TS 类型、Mock 生成器、工具、图标",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "import": "./src/tokens/index.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "import": "./src/types/index.ts"
    },
    "./mock": {
      "types": "./src/mock/index.ts",
      "import": "./src/mock/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts"
    },
    "./tokens.scss": "./src/tokens/tokens.scss",
    "./tokens.css": "./src/tokens/tokens.css",
    "./wot-overrides.scss": "./src/tokens/wot-overrides.scss",
    "./glass-surface.vue": "./src/ui/GlassSurface.vue",
    "./primary-liquid-tabbar.vue": "./src/ui/PrimaryLiquidTabBar.vue"
  },
  "files": [
    "dist",
    "src/tokens/tokens.scss",
    "src/tokens/tokens.css",
    "src/tokens/wot-overrides.scss",
    "src/icons"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint: shared'",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@aslanonur/liquid-glass-vue": "1.1.3",
    "@faker-js/faker": "^9.0.3",
    "dayjs": "^1.11.13",
    "nanoid": "^5.0.7",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "~5.6.3"
  }
}
