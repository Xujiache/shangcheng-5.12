FROM node:24-bookworm-slim AS server-build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
 && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@9.0.0
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY packages/server ./packages/server
RUN pnpm install --filter @jiujiu/server... --frozen-lockfile --ignore-scripts
RUN pnpm --filter @jiujiu/shared build \
 && pnpm --filter @jiujiu/server prisma:generate \
 && pnpm --filter @jiujiu/server build \
 && pnpm --filter @jiujiu/server deploy --prod --ignore-scripts /out \
 && node /app/packages/server/node_modules/prisma/build/index.js generate --schema=/out/prisma/schema.prisma

FROM node:24-bookworm-slim AS source-build
WORKDIR /app/flyingmouse
COPY vendor/flyingmouse-format/upstream-a7b9b15 ./
COPY scripts/apply-flyingmouse-platform-fixes.cjs /app/scripts/apply-flyingmouse-platform-fixes.cjs
COPY scripts/flyingmouse-patches/presentation-html.js.inc /app/scripts/flyingmouse-patches/presentation-html.js.inc
COPY scripts/flyingmouse-patches/zip-image-batch.js.inc /app/scripts/flyingmouse-patches/zip-image-batch.js.inc
RUN npm ci --omit=dev --no-audit --no-fund \
 && node scripts/restore-pandoc.js \
 && node /app/scripts/apply-flyingmouse-platform-fixes.cjs --in-place /app/flyingmouse \
 && rm -rf output

FROM debian:bookworm-slim AS davs2-build
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl build-essential pkg-config nasm \
 && rm -rf /var/lib/apt/lists/*
RUN curl --retry 3 -fsSL https://github.com/pkuvcl/davs2/archive/refs/tags/1.7.tar.gz -o /tmp/davs2.tar.gz \
 && echo 'b697d0b376a1c7f7eda3a4cc6d29707c8154c4774358303653f0a9727f923cc8  /tmp/davs2.tar.gz' | sha256sum -c - \
 && tar -xzf /tmp/davs2.tar.gz -C /tmp \
 && cd /tmp/davs2-1.7/build/linux \
 && ./configure --prefix=/opt/davs2-1.7 --enable-shared --disable-static --disable-cli \
 && make -j2 && make install

FROM debian:bookworm-slim AS uavs3d-build
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl build-essential cmake gawk \
 && rm -rf /var/lib/apt/lists/*
RUN curl --retry 3 -fsSL https://github.com/uavs3/uavs3d/archive/refs/tags/1.2.tar.gz -o /tmp/uavs3d.tar.gz \
 && echo 'faa1f1f82badc0603d9944bb5af7b961dd42236e2c3a7aa8fcfc080bbeb5b157  /tmp/uavs3d.tar.gz' | sha256sum -c - \
 && tar -xzf /tmp/uavs3d.tar.gz -C /tmp \
 && cmake -S /tmp/uavs3d-1.2 -B /tmp/uavs3d-build -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/opt/uavs3d-1.2 -DBUILD_SHARED_LIBS=ON -DCOMPILE_10BIT=ON \
 && cmake --build /tmp/uavs3d-build -j2 \
 && cmake --install /tmp/uavs3d-build

FROM debian:bookworm-slim AS ffmpeg-build
COPY --from=davs2-build /opt/davs2-1.7 /opt/davs2-1.7
COPY --from=uavs3d-build /opt/uavs3d-1.2 /opt/uavs3d-1.2
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl build-essential cmake pkg-config yasm nasm \
    libx264-dev libx265-dev libsvtav1-dev libvpx-dev libopus-dev libmp3lame-dev \
    libjxl-dev libopenjp2-7-dev libwebp-dev libaom-dev libass-dev \
    libfreetype6-dev libfontconfig1-dev libfribidi-dev \
 && rm -rf /var/lib/apt/lists/*
RUN curl --retry 3 -fsSL https://github.com/AOMediaCodec/SVT-AV1/archive/refs/tags/v1.4.1.tar.gz -o /tmp/svt-av1.tar.gz \
 && echo '4546773a087ee546d65e05bb0f12c9d15b1ca450d3dc154b72f85e4d541a081a  /tmp/svt-av1.tar.gz' | sha256sum -c - \
 && tar -xzf /tmp/svt-av1.tar.gz -C /tmp \
 && cmake -S /tmp/SVT-AV1-1.4.1 -B /tmp/svt-av1-build \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/svt-av1-1.4.1 \
    -DBUILD_SHARED_LIBS=ON -DBUILD_TESTING=OFF -DBUILD_APPS=OFF -DBUILD_DEC=OFF \
 && cmake --build /tmp/svt-av1-build -j2 \
 && cmake --install /tmp/svt-av1-build \
 && rm -rf /tmp/svt-av1.tar.gz /tmp/SVT-AV1-1.4.1 /tmp/svt-av1-build
RUN apt-get update && apt-get install -y --no-install-recommends librsvg2-dev \
 && rm -rf /var/lib/apt/lists/*
RUN curl --retry 3 -fsSL https://ffmpeg.org/releases/ffmpeg-8.1.1.tar.xz -o /tmp/ffmpeg.tar.xz \
 && echo 'b6863adde98898f42602017462871b5f6333e65aec803fdd7a6308639c52edf3  /tmp/ffmpeg.tar.xz' | sha256sum -c - \
 && tar -xf /tmp/ffmpeg.tar.xz -C /tmp \
 && cd /tmp/ffmpeg-8.1.1 \
 && PKG_CONFIG_PATH=/opt/davs2-1.7/lib/pkgconfig:/opt/uavs3d-1.2/lib/pkgconfig:/opt/svt-av1-1.4.1/lib/pkgconfig \
    ./configure --prefix=/opt/ffmpeg-8.1.1 --enable-shared --disable-static \
    --enable-gpl --enable-version3 --enable-libx264 --enable-libx265 \
    --enable-libsvtav1 --enable-libvpx --enable-libopus --enable-libmp3lame \
    --enable-libjxl --enable-libopenjpeg --enable-libwebp --enable-libaom \
    --enable-libdavs2 --enable-libuavs3d --enable-librsvg \
    --enable-libass --enable-libfreetype --enable-libfontconfig --enable-libfribidi \
 && make -j2 && make install \
 && rm -rf /tmp/ffmpeg.tar.xz /tmp/ffmpeg-8.1.1

