COPY --chown=node:node packages/server/scripts/run-original-docstructure-linux.sh /usr/local/bin/jiujiu-docstructure
COPY --chown=node:node packages/server/scripts/run-original-qpdf.sh /usr/local/bin/jiujiu-qpdf
RUN chmod 755 /usr/local/bin/jiujiu-docengine /usr/local/bin/jiujiu-docstructure /usr/local/bin/jiujiu-qpdf
ENV NODE_ENV=production FLYINGMOUSE_SOURCE_DIR=/app/flyingmouse \
    FLYINGMOUSE_DOCENGINE_PATH=/usr/local/bin/jiujiu-docengine \
    FLYINGMOUSE_DOCSTRUCTURE_PYTHON=/opt/docstructure-venv/bin/python \
    FLYINGMOUSE_DOCSTRUCTURE_ENGINE_PATH=/usr/local/bin/jiujiu-docstructure \
    FLYINGMOUSE_DOCSTRUCTURE_MODEL_DIR=/opt/docstructure-models \
    FLYINGMOUSE_DCRAW_PATH=/usr/local/bin/dcraw_emu \
    FLYINGMOUSE_FFMPEG_PATH=/opt/ffmpeg-8.1.1/bin/ffmpeg \
    FLYINGMOUSE_PDFTOPPM_PATH=/opt/poppler-26.05.0/bin/pdftoppm \
    FLYINGMOUSE_OFD_FONT_DIR=/opt/ofd-fonts \
