FROM node:24-bookworm-slim AS server-build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
 && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@9
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY packages/server ./packages/server
RUN pnpm install --filter @jiujiu/server... --frozen-lockfile --ignore-scripts
RUN pnpm --filter @jiujiu/shared build \
 && pnpm --filter @jiujiu/server prisma:generate \
 && pnpm --filter @jiujiu/server build \
 && pnpm --filter @jiujiu/server deploy --prod --ignore-scripts /out \
 && node /app/packages/server/node_modules/prisma/build/index.js generate --schema=/out/prisma/schema.prisma

FROM node:24-bookworm-slim AS source-build
WORKDIR /app/flyingmouse
COPY vendor/flyingmouse-format/v0.7.10 ./
RUN rm -rf bin/avs3 && npm ci --omit=dev --no-audit --no-fund

FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates openssl ffmpeg libreoffice-writer libreoffice-calc libreoffice-impress \
    poppler-utils tesseract-ocr tesseract-ocr-chi-sim pandoc qpdf dcraw \
    ghostscript fonts-noto-cjk \
 && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production FLYINGMOUSE_SOURCE_DIR=/app/flyingmouse \
    FLYINGMOUSE_DCRAW_PATH=/usr/bin/dcraw \
    FLYINGMOUSE_TESSDATA_PATH=/usr/share/tesseract-ocr/5/tessdata \
    HOME=/tmp XDG_CONFIG_HOME=/tmp
WORKDIR /app/server
COPY --from=server-build --chown=node:node /out ./
COPY --from=source-build --chown=node:node /app/flyingmouse /app/flyingmouse
USER node
CMD ["node", "dist/src/workers/conversion.worker.js"]
