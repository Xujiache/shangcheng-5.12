RUN python3 -m venv /opt/pdf2docx-venv \
 && /opt/pdf2docx-venv/bin/pip install --no-cache-dir --require-hashes -r /tmp/docengine-requirements.lock \
 && /opt/pdf2docx-venv/bin/pip check \
 && rm /tmp/docengine-requirements.lock
COPY --chown=node:node packages/server/scripts/run-original-docengine.py /usr/local/libexec/run-original-docengine.py
COPY --chown=node:node packages/server/scripts/run-original-docengine.sh /usr/local/bin/jiujiu-docengine
COPY packages/server/scripts/docstructure-requirements-linux.lock /tmp/docstructure-requirements.lock
RUN /usr/bin/python3 -m venv /opt/docstructure-venv \
 && /opt/docstructure-venv/bin/pip install --no-cache-dir --require-hashes -r /tmp/docstructure-requirements.lock \
 && /opt/docstructure-venv/bin/pip check \
