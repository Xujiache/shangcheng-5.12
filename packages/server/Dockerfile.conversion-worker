FROM debian:bookworm-slim AS poppler-build
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl build-essential pkg-config ninja-build python3 python3-venv \
    gperf libexpat1-dev libbz2-dev \
    libfreetype6-dev libfontconfig1-dev libjpeg-dev libpng-dev \
    libopenjp2-7-dev liblcms2-dev libtiff-dev zlib1g-dev \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -m venv /opt/cmake-venv \
 && /opt/cmake-venv/bin/pip install --no-cache-dir cmake==3.31.10
RUN curl --retry 3 -fsSL https://download.savannah.gnu.org/releases/freetype/freetype-2.13.3.tar.xz -o /tmp/freetype.tar.xz \
 && echo '0550350666d427c74daeb85d5ac7bb353acba5f76956395995311a9c6f063289  /tmp/freetype.tar.xz' | sha256sum -c - \
 && tar -xf /tmp/freetype.tar.xz -C /tmp \
 && cd /tmp/freetype-2.13.3 \
 && ./configure --prefix=/opt/poppler-deps --disable-static --enable-shared \
 && make -j2 && make install \
 && rm -rf /tmp/freetype.tar.xz /tmp/freetype-2.13.3
RUN curl --retry 3 -fsSL https://www.freedesktop.org/software/fontconfig/release/fontconfig-2.15.0.tar.gz -o /tmp/fontconfig.tar.gz \
 && echo 'f5f359d6332861bd497570848fcb42520964a9e83d5e3abe397b6b6db9bcaaf4  /tmp/fontconfig.tar.gz' | sha256sum -c - \
 && tar -xzf /tmp/fontconfig.tar.gz -C /tmp \
 && cd /tmp/fontconfig-2.15.0 \
 && PKG_CONFIG_PATH=/opt/poppler-deps/lib/pkgconfig \
    LDFLAGS=-Wl,-rpath,/opt/poppler-deps/lib \
    ./configure --prefix=/opt/poppler-deps --disable-static --enable-shared \
    --with-default-fonts=/usr/share/fonts,/usr/local/share/fonts,/opt/ofd-fonts \
