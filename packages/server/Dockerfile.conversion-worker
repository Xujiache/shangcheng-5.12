RUN curl --retry 3 -fsSL https://poppler.freedesktop.org/poppler-26.05.0.tar.xz -o /tmp/poppler.tar.xz \
 && echo '6fef27ff04f37db43054c86bcdff6128c9fb1f6af4ef3c8b369a7e9abd68d0bb  /tmp/poppler.tar.xz' | sha256sum -c - \
 && tar -xf /tmp/poppler.tar.xz -C /tmp \
 && PKG_CONFIG_PATH=/opt/poppler-deps/lib/pkgconfig \
    /opt/cmake-venv/bin/cmake -S /tmp/poppler-26.05.0 -B /tmp/poppler-build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/poppler-26.05.0 \
    -DCMAKE_PREFIX_PATH=/opt/poppler-deps \
    -DENABLE_UTILS=ON -DENABLE_CPP=OFF -DENABLE_GLIB=OFF \
    -DENABLE_QT5=OFF -DENABLE_QT6=OFF -DENABLE_NSS3=OFF \
    -DENABLE_GPGME=OFF -DENABLE_LIBCURL=OFF -DENABLE_BOOST=OFF \
 && /opt/cmake-venv/bin/cmake --build /tmp/poppler-build -j2 \
 && /opt/cmake-venv/bin/cmake --install /tmp/poppler-build \
 && rm -rf /tmp/poppler.tar.xz /tmp/poppler-26.05.0 /tmp/poppler-build

