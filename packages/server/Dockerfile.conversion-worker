    FLYINGMOUSE_LIBREOFFICE_PATH=/opt/libreoffice26.2/program/soffice \
    FLYINGMOUSE_TESSDATA_PATH=/opt/flyingmouse-tessdata \
    FLYINGMOUSE_QPDF_PATH=/usr/local/bin/jiujiu-qpdf \
    LD_LIBRARY_PATH=/opt/ffmpeg-8.1.1/lib:/opt/davs2-1.7/lib:/opt/uavs3d-1.2/lib:/opt/svt-av1-1.4.1/lib:/opt/poppler-26.05.0/lib:/opt/poppler-deps/lib \
    FONTCONFIG_PATH=/opt/poppler-deps/etc/fonts \
    HOME=/tmp XDG_CONFIG_HOME=/tmp
WORKDIR /app/server
COPY --from=libraw-build /tmp/LibRaw-0.21.5/bin/dcraw_emu /usr/local/bin/dcraw_emu
COPY --from=ffmpeg-build /opt/ffmpeg-8.1.1 /opt/ffmpeg-8.1.1
COPY --from=davs2-build /opt/davs2-1.7 /opt/davs2-1.7
COPY --from=uavs3d-build /opt/uavs3d-1.2 /opt/uavs3d-1.2
COPY --from=ffmpeg-build /opt/svt-av1-1.4.1 /opt/svt-av1-1.4.1
COPY --from=poppler-build /opt/poppler-26.05.0 /opt/poppler-26.05.0
COPY --from=poppler-build /opt/poppler-deps /opt/poppler-deps
COPY --from=windows-tessdata-build --chown=node:node /opt/flyingmouse-tessdata /opt/flyingmouse-tessdata
COPY --from=windows-tessdata-build --chown=node:node /opt/docengine /opt/docengine
COPY --from=ofd-font-build --chown=node:node /ofd-fonts /opt/ofd-fonts
COPY --from=docstructure-model-build --chown=node:node /opt/docstructure-models /opt/docstructure-models
COPY --from=libreoffice-build /lo/opt/libreoffice26.2 /opt/libreoffice26.2
COPY --from=qpdf-build /opt/qpdf-12.4.0 /opt/qpdf-12.4.0
COPY --from=server-build --chown=node:node /out ./
COPY --from=source-build --chown=node:node /app/flyingmouse /app/flyingmouse
