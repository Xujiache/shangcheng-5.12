FROM python:3.12-slim-bookworm
COPY --from=server-build /usr/local/bin/node /usr/local/bin/node
RUN groupadd --gid 1000 node && useradd --uid 1000 --gid node --create-home node
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates openssl unzip ffmpeg libreoffice-writer libreoffice-calc libreoffice-impress \
    poppler-utils tesseract-ocr tesseract-ocr-chi-sim pandoc qpdf dcraw libheif-examples \
    python3 python3-venv libgomp1 libgl1 libglib2.0-0 librsvg2-2 \
    ghostscript fonts-noto-cjk \
