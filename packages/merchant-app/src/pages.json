{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/startup/index",
      "style": { "navigationBarTitleText": "", "navigationStyle": "custom" }
    },
    {
      "path": "pages/auth/login",
      "style": { "navigationBarTitleText": "登录", "navigationStyle": "custom" }
    },
    { "path": "pages/auth/apply", "style": { "navigationBarTitleText": "商家入驻" } },
    {
      "path": "pages/auth/set-password",
      "style": { "navigationBarTitleText": "设置密码", "navigationStyle": "custom" }
    },
    {
      "path": "pages/tabbar/home/index",
      "style": {
        "navigationBarTitleText": "经纬科技 · 商家版",
        "enablePullDownRefresh": true,
        "backgroundColor": "#F5F6F8"
      }
    },
    { "path": "pages/tabbar/product/index", "style": { "navigationBarTitleText": "商品" } },
    { "path": "pages/tabbar/order/index", "style": { "navigationBarTitleText": "订单" } },
    { "path": "pages/tabbar/stats/index", "style": { "navigationBarTitleText": "数据" } },
    { "path": "pages/tabbar/me/index", "style": { "navigationBarTitleText": "我的" } },
    { "path": "pages/product/add", "style": { "navigationBarTitleText": "添加商品" } },
    { "path": "pages/product/category", "style": { "navigationBarTitleText": "分类管理" } },
    { "path": "pages/product/agency-list", "style": { "navigationBarTitleText": "代理商品" } },
    { "path": "pages/order/detail", "style": { "navigationBarTitleText": "订单详情" } },
    { "path": "pages/order/aftersale", "style": { "navigationBarTitleText": "售后处理" } },
    { "path": "pages/customer/index", "style": { "navigationBarTitleText": "客户管理" } },
    { "path": "pages/commission/setting", "style": { "navigationBarTitleText": "佣金设置" } },
    { "path": "pages/store/index", "style": { "navigationBarTitleText": "门店管理" } },
    { "path": "pages/store/auth", "style": { "navigationBarTitleText": "门店授权" } },
    { "path": "pages/staff/index", "style": { "navigationBarTitleText": "员工管理" } },
    { "path": "pages/shop/decorate", "style": { "navigationBarTitleText": "店铺装修" } },
    { "path": "pages/marketing/index", "style": { "navigationBarTitleText": "营销中心" } },
    { "path": "pages/chat/sessions", "style": { "navigationBarTitleText": "客户消息" } },
    {
      "path": "pages/chat/index",
      "style": {
        "navigationBarTitleText": "在线客服",
        "navigationStyle": "custom",
        "app-plus": {
          "softinputMode": "adjustResize",
          "bounce": "none"
        }
      }
    },
    {
      "path": "pages/update/index",
      "style": { "navigationBarTitleText": "", "navigationStyle": "custom" }
    },
    { "path": "pages/plaza/index", "style": { "navigationBarTitleText": "选品广场" } },
    { "path": "pages/plaza/factory", "style": { "navigationBarTitleText": "厂家详情" } },
    { "path": "pages/member/index", "style": { "navigationBarTitleText": "会员开通" } },
    { "path": "pages/me/profile", "style": { "navigationBarTitleText": "个人信息" } },
    { "path": "pages/me/settings", "style": { "navigationBarTitleText": "系统设置" } },
    { "path": "pages/me/share", "style": { "navigationBarTitleText": "分享 APP" } },
    { "path": "pages/shop/price-rule", "style": { "navigationBarTitleText": "价格显示规则" } }
  ],
  "globalStyle": {
    "navigationStyle": "custom",
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "经纬科技",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F7F8FA"
  }
}
